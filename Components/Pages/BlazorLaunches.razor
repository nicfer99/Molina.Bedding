@page "/blazor/launches/{ActionId}"
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject BlazorProductionDeclarationState FlowState
@inject IProductionDeclarationFlowService FlowService
@inject IJSRuntime JsRuntime

<section class="page-section page-section--wide page-section--launches"
         data-launches-page="true"
         data-direct-requires-material-lot-selection="@(Model?.RequiresMaterialLotSelection.ToString().ToLowerInvariant() ?? "false")">
    <header class="page-header page-header--compact page-header--workmenu">
        <div>
            <div class="page-kicker">Schermata 3</div>
            <h1>Selezione lotto</h1>
            <p class="page-intro">@GetPageIntro()</p>
        </div>
        <div class="selected-operators-panel" aria-label="Operatori selezionati">
            <div class="selected-operators-head">
                <span class="note-label">Operatori selezionati</span>
                <strong>@(Model?.SelectedOperators.Count ?? 0)</strong>
            </div>
            <div class="selected-operators-list">
                @foreach (var operatorItem in Model?.SelectedOperators ?? Enumerable.Empty<OperatorItemViewModel>())
                {
                    <span class="selected-operator-chip">@operatorItem.Name</span>
                }
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="inline-alert inline-alert--success" role="status">@SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ValidationMessage))
    {
        <div class="inline-alert" role="alert">@ValidationMessage</div>
    }

    @if (Model is null)
    {
        <div class="inline-alert">Caricamento lotti...</div>
    }
    else
    {
        <div id="launchSelectionForm" data-add-launch-from-barcode-url="">
            <input type="hidden" name="ActionId" value="@Model.ActionId" />
            <input type="hidden" name="SelectedOrderIds" id="SelectedOrderIds" value="@GetSelectedOrderIdsValue()" />
            <input type="hidden" name="ProductionMode" value="@Model.ProductionMode" />
            <input type="hidden" name="AutoInsertOnBarcodeEnabled" id="AutoInsertOnBarcodeEnabled" value="@FormatBool(AutoInsertOnBarcode)" />
            <input type="hidden" name="AutoFillMaxOnBarcode" id="AutoFillMaxOnBarcode" value="false" />
            <input type="hidden" name="PrefilledSelectionsJson" id="PrefilledSelectionsJson" value="@SerializePrefillSelections()" />
            <input type="hidden" name="BarcodeValue" id="BarcodeValue" value="@BarcodeValue" />
            <div class="barcode-panel">
                <label for="lotBarcode" class="barcode-label">Barcode lotto</label>
                <input type="text"
                       id="lotBarcode"
                       class="barcode-input"
                       autocomplete="off"
                       inputmode="text"
                       @bind="BarcodeValue"
                       @bind:event="oninput"
                       @onkeydown="HandleBarcodeKeydownAsync" />
            </div>

            <div class="launch-toggle-panel">
                <label class="launch-toggle-switch" for="autoInsertOnBarcodeToggle">
                    <input type="checkbox" id="autoInsertOnBarcodeToggle" checked="@AutoInsertOnBarcode" @onchange="ToggleAutoInsertAsync" />
                    <span class="launch-toggle-switch__track"></span>
                    <span class="launch-toggle-switch__label">Attiva inserimento diretto quando scannerizzo il barcode</span>
                </label>
            </div>

            <div class="launch-grid" aria-label="Lotti disponibili">
                @foreach (var launch in Model.Launches)
                {
                    var producedValue = launch.QuantityProduced ?? 0m;
                    var remainingValue = GetRemainingQuantity(launch);
                    var launchMaterialLotsBase64 = EncodeMaterialLots(launch.AvailableMaterialLots);
                    var isSelected = SelectedOrderIds.Contains(launch.OrderId);
                    var prefill = GetPrefill(launch.OrderId);
                    var hasPrefill = isSelected && !string.IsNullOrWhiteSpace(prefill?.QuantityDeclared);
                    <article class="@GetLaunchCardClass(launch)"
                             data-order-id="@launch.OrderId"
                             data-lot-code="@launch.LotCode"
                             data-max-qty="@FormatQuantityInvariant(launch.QuantityToProduce)"
                             data-produced-qty="@FormatQuantityInvariant(producedValue)"
                             data-remaining-qty="@FormatQuantityInvariant(remainingValue)"
                             data-material-lots-base64="@launchMaterialLotsBase64"
                             data-material-lot-error="@(launch.MaterialLotValidationMessage ?? string.Empty)"
                             aria-pressed="@(isSelected ? "true" : "false")"
                             @onclick="() => ToggleLaunchAsync(launch)">
                        <button type="button"
                                class="launch-card-remove"
                                data-order-id="@launch.OrderId"
                                aria-label="Togli questo lotto dalla selezione"
                                title="Togli dalla selezione"
                                @onclick:stopPropagation="true"
                                @onclick="() => RemoveLaunchAsync(launch.OrderId)">
                            ×
                        </button>
                        <span class="launch-card-code">@launch.LotCode</span>
                        @if (launch.IsClosed)
                        {
                            <span class="launch-card-status">Chiuso</span>
                        }
                        <span class="launch-card-doc-number">@(!string.IsNullOrWhiteSpace(launch.DocumentNumber) ? $"Doc. {launch.DocumentNumber}" : string.Empty)</span>
                        <span class="launch-card-fields">
                            <span class="launch-field">
                                <span class="launch-field-label">Qta da produrre</span>
                                <span class="launch-field-value">@FormatQuantity(launch.QuantityToProduce)</span>
                            </span>
                            <span class="launch-field">
                                <span class="launch-field-label">Qta prodotta</span>
                                <span class="launch-field-value@(launch.QuantityProduced.GetValueOrDefault() > 0 ? " launch-field-value--produced" : string.Empty)">@FormatQuantity(launch.QuantityProduced ?? 0m)</span>
                            </span>
                        </span>
                        <div class="launch-card-direct-summary@(hasPrefill ? string.Empty : " is-hidden")" data-launch-prefill-summary="true">
                            <div class="launch-card-direct-summary__row">
                                <span class="note-label">Qta impostata</span>
                                <strong data-launch-prefill-qty="true">@(hasPrefill ? prefill?.QuantityDeclared : "-")</strong>
                            </div>
                            @if (Model.RequiresMaterialLotSelection)
                            {
                                <div class="launch-card-direct-summary__row">
                                    <span class="note-label">Lotto</span>
                                    <button type="button"
                                            class="launch-card-direct-summary__lot-button"
                                            data-open-launch-direct-modal="true"
                                            aria-label="Modifica il lotto selezionato in Schermata 3"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenDirectModal(launch)">
                                        <span data-launch-prefill-lot="true">@(hasPrefill && !string.IsNullOrWhiteSpace(prefill?.SelectedMaterialLotCode) ? prefill.SelectedMaterialLotCode : "Nessun lotto selezionato")</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="form-footer form-footer--split">
                <a href="/blazor/work-menu" class="secondary-action-link">Indietro</a>
                <button type="button" id="launchContinueButton" class="primary-action-button launch-continue-button" disabled="@(SelectedOrderIds.Count == 0 || Model.Launches.Count == 0)" @onclick="ContinueAsync">
                    Avanti
                </button>
            </div>
        </div>
    }
</section>

<div class="screen4-qty-modal" id="launchDirectInsertModal" hidden="@(ActiveDirectLaunch is null)">
        <div class="screen4-qty-modal__backdrop" data-close-launch-direct-modal="true" @onclick="CloseDirectModal"></div>
        <div class="screen4-qty-modal__dialog launch-direct-modal" role="dialog" aria-modal="true" aria-labelledby="launchDirectInsertModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Schermata 3</div>
                    <h2 id="launchDirectInsertModalTitle">Dati da riportare in Schermata 4</h2>
                    <div class="screen4-modal-lot" data-launch-direct-lot="true">@(ActiveDirectLaunch?.LotCode ?? "-")</div>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-launch-direct-modal="true" @onclick="CloseDirectModal" aria-label="Chiudi finestra">×</button>
            </div>

            <div class="screen4-qty-modal__content launch-direct-modal__content">
                <div class="launch-direct-modal__sections@(Model?.RequiresMaterialLotSelection == true ? string.Empty : " launch-direct-modal__sections--single")">
                    <section class="launch-direct-panel launch-direct-panel--quantity" aria-label="Sezione quantità">
                        <div class="launch-direct-panel__header launch-direct-panel__header--stacked">
                            <div>
                                <div class="page-kicker">Quantità</div>
                                <strong class="launch-direct-panel__title">Imposta la quantità dichiarata</strong>
                                <p class="screen4-qty-modal__intro launch-direct-panel__intro">Scegli se usare la qta massima residua oppure una qta parziale.</p>
                            </div>
                        </div>

                        <div class="screen4-qty-modal__info">
                            <div class="screen4-qty-modal__info-box">
                                <span class="note-label">Qta residua</span>
                                <strong data-launch-direct-max="true">@(ActiveDirectLaunch is null ? "0" : FormatQuantity(GetRemainingQuantity(ActiveDirectLaunch)))</strong>
                            </div>
                            <div class="screen4-qty-modal__info-box screen4-qty-modal__info-box--declared">
                                <span class="note-label">Qta impostata</span>
                                <strong data-launch-direct-qty-display="true">@(string.IsNullOrWhiteSpace(DirectQuantity) ? "0" : DirectQuantity)</strong>
                            </div>
                        </div>

                        <div class="launch-direct-qty-actions" aria-label="Scelta quantità">
                            <button type="button" class="screen4-slot-button screen4-slot-button--max launch-direct-qty-action" data-launch-direct-set-max="true" @onclick="SetDirectMax">Max</button>
                            <button type="button" class="screen4-slot-button screen4-slot-button--partial launch-direct-qty-action" data-launch-direct-open-partial="true" @onclick="OpenDirectPartialModal">
                                Qta Parziale
                            </button>
                        </div>
                    </section>

                    @if (Model?.RequiresMaterialLotSelection == true)
                    {
                        <section class="launch-direct-panel launch-direct-panel--lot" aria-label="Sezione lotto">
                            <div class="launch-direct-panel__header launch-direct-panel__header--stacked">
                                <div>
                                    <div class="page-kicker">Lotto</div>
                                    <strong class="launch-direct-panel__title" data-launch-direct-material-lot-display="true">@(string.IsNullOrWhiteSpace(DirectMaterialLotCode) ? "Nessun lotto selezionato" : DirectMaterialLotCode)</strong>
                                    <p class="screen4-qty-modal__intro launch-direct-panel__intro">Puoi selezionare il lotto materiale, oppure proseguire senza lotto.</p>
                                </div>
                            </div>
                            <div class="launch-direct-material-lot-panel">
                                <input type="hidden" id="launchDirectMaterialLotInput" value="@DirectMaterialLotCode" />
                                <div class="@GetDirectMaterialLotHelpClass()" data-launch-direct-material-lot-help="true">
                                    @GetDirectMaterialLotHelpText()
                                </div>
                                <div class="material-lot-reference-list" data-launch-direct-material-lot-list="true" aria-label="Lotti disponibili">
                                    @foreach (var materialLot in ActiveDirectLaunch?.AvailableMaterialLots ?? System.Linq.Enumerable.Empty<string>())
                                    {
                                        <button type="button"
                                                class="material-lot-reference-chip@(string.Equals(DirectMaterialLotCode, materialLot, StringComparison.OrdinalIgnoreCase) ? " is-selected" : string.Empty)"
                                                data-launch-direct-material-lot-reference="@materialLot"
                                                aria-pressed="@(string.Equals(DirectMaterialLotCode, materialLot, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                                @onclick="() => SetDirectMaterialLot(materialLot)">
                                            @materialLot
                                        </button>
                                    }
                                </div>
                            </div>
                        </section>
                    }
                </div>
            </div>

            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-close-launch-direct-modal="true" @onclick="CloseDirectModal">Chiudi</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-launch-direct-insert="true" @onclick="ConfirmDirectInsertAsync">Conferma dati</button>
                </div>
            </div>
        </div>
    </div>

<div class="screen4-qty-modal" id="launchDirectPartialQuantityModal" hidden="@(!(ShowDirectPartialModal && ActiveDirectLaunch is not null))">
        <div class="screen4-qty-modal__backdrop" data-close-launch-direct-partial-modal="true" @onclick="CloseDirectPartialModal"></div>
        <div class="screen4-qty-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="launchDirectPartialQuantityModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Quantità parziale</div>
                    <h2 id="launchDirectPartialQuantityModalTitle">Inserisci la quantità dichiarata</h2>
                    <p class="screen4-qty-modal__intro">Inserisci la qta dichiarata per il lotto selezionato. Se supera il residuo disponibile, ti verrà chiesta una conferma dedicata.</p>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-launch-direct-partial-modal="true" @onclick="CloseDirectPartialModal" aria-label="Chiudi finestra">×</button>
            </div>

            <div class="screen4-qty-modal__content">
                <div class="screen4-qty-modal__info">
                    <div class="screen4-qty-modal__info-box">
                        <span class="note-label" id="launchDirectPartialQtyModalReferenceLabel">Qta residua</span>
                        <strong id="launchDirectPartialQtyModalMax">@(ActiveDirectLaunch is null ? "0" : FormatQuantity(GetRemainingQuantity(ActiveDirectLaunch)))</strong>
                    </div>
                    <div class="screen4-qty-modal__info-box screen4-qty-modal__info-box--declared">
                        <span class="note-label">Qta dichiarata</span>
                        <strong id="launchDirectPartialQtyModalDisplay">@(string.IsNullOrWhiteSpace(DirectPartialQuantity) ? "0" : DirectPartialQuantity)</strong>
                    </div>
                </div>

                <div class="screen4-qty-keypad">
                    @foreach (var key in QuantityKeys)
                    {
                        <button type="button"
                                class="screen4-qty-key@(key is "C" or "Del" ? " screen4-qty-key--secondary" : string.Empty)"
                                data-launch-direct-partial-keypad-value="@GetDirectPartialKeypadValue(key)"
                                data-launch-direct-partial-keypad-action="@GetDirectPartialKeypadAction(key)"
                                @onclick="() => PressDirectPartialKey(key)">
                            @(key == "Del" ? "⌫" : key)
                        </button>
                    }
                </div>
            </div>

            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-clear-launch-direct-partial="true" @onclick="ClearDirectPartialQuantity">Annulla qta dichiarata</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-launch-direct-partial-modal="true" @onclick="CloseDirectPartialModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-launch-direct-partial="true" @onclick="ConfirmDirectPartialQuantityAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>

@code {
    [Parameter] public string ActionId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "productionMode")] public string? ProductionMode { get; set; }

    private static readonly string[] QuantityKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "Del", ","];

    private ProductionLaunchSelectionViewModel? Model { get; set; }
    private HashSet<int> SelectedOrderIds { get; } = [];
    private Dictionary<int, ProductionLaunchPrefillSelectionItem> PrefillSelections { get; } = [];
    private bool AutoInsertOnBarcode { get; set; }
    private string BarcodeValue { get; set; } = string.Empty;
    private string? ValidationMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private ProductionLaunchItemViewModel? ActiveDirectLaunch { get; set; }
    private string DirectQuantity { get; set; } = string.Empty;
    private string DirectPartialQuantity { get; set; } = string.Empty;
    private string DirectMaterialLotCode { get; set; } = string.Empty;
    private bool ShowDirectPartialModal { get; set; }
    private DotNetObjectReference<BlazorLaunches>? BarcodeReference { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncModalStateAsync();

        if (!firstRender)
        {
            return;
        }

        await FlowState.EnsureLoadedAsync();
        if (FlowState.SelectedOperatorIds.Count == 0)
        {
            Navigation.NavigateTo("/blazor/operators");
            return;
        }

        var normalizedMode = FlowService.NormalizeProductionMode(ProductionMode) ?? FlowState.ProductionMode;
        if (!string.Equals(FlowState.SelectedActionId, ActionId, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(FlowState.ProductionMode, normalizedMode, StringComparison.OrdinalIgnoreCase))
        {
            await FlowState.SetActionAsync(ActionId, normalizedMode);
        }

        await LoadModelAsync(null, null);
        BarcodeReference = DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync(
            "molinaBlazorBarcode.activate",
            "lotBarcode",
            new[] { "#launchDirectInsertModal", "#launchDirectPartialQuantityModal" },
            BarcodeReference);
        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
        StateHasChanged();
    }

    private async Task LoadModelAsync(string? validationMessage, string? successMessage)
    {
        Model = FlowService.BuildLaunchesModel(FlowState, ActionId, ProductionMode, validationMessage, successMessage);
        ValidationMessage = Model.ValidationMessage;
        SuccessMessage = Model.SuccessMessage;
        AutoInsertOnBarcode = Model.AutoInsertOnBarcodeEnabled;
        SelectedOrderIds.Clear();
        foreach (var id in FlowState.SelectedLaunchOrderIds)
        {
            SelectedOrderIds.Add(id);
        }

        PrefillSelections.Clear();
        foreach (var item in FlowState.LaunchPrefillSelections)
        {
            PrefillSelections[item.OrderId] = item;
        }

        await Task.CompletedTask;
    }

    private string GetPageIntro()
    {
        if (Model is null)
        {
            return string.Empty;
        }

        var modeText = Model.ProductionMode switch
        {
            "riempimento" => " - Riempimento",
            "macchina" => " - Macchina",
            _ => string.Empty
        };

        return $"{Model.AreaTitle} - {Model.ActionText}{modeText}";
    }

    private string GetLaunchCardClass(ProductionLaunchItemViewModel launch)
    {
        return "launch-card"
            + (SelectedOrderIds.Contains(launch.OrderId) ? " is-selected" : string.Empty)
            + (launch.IsClosed ? " is-closed" : string.Empty);
    }

    private async Task ToggleLaunchAsync(ProductionLaunchItemViewModel launch)
    {
        if (!SelectedOrderIds.Add(launch.OrderId))
        {
            SelectedOrderIds.Remove(launch.OrderId);
            PrefillSelections.Remove(launch.OrderId);
        }

        await PersistSelectionAsync(false);
    }

    private async Task RemoveLaunchAsync(int orderId)
    {
        SelectedOrderIds.Remove(orderId);
        PrefillSelections.Remove(orderId);
        await PersistSelectionAsync(false);
    }

    private async Task PersistSelectionAsync(bool autoFillMax)
    {
        await FlowState.SetLaunchSelectionAsync(
            ActionId,
            FlowService.NormalizeProductionMode(ProductionMode) ?? FlowState.ProductionMode,
            SelectedOrderIds,
            AutoInsertOnBarcode,
            autoFillMax,
            PrefillSelections.Values);
    }

    private async Task ToggleAutoInsertAsync(ChangeEventArgs args)
    {
        AutoInsertOnBarcode = args.Value is bool value && value;
        await FlowState.SetAutoInsertAsync(AutoInsertOnBarcode);
    }

    private async Task HandleBarcodeKeydownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
        {
            return;
        }

        await AddBarcodeAsync();
    }

    private async Task AddBarcodeAsync()
    {
        var rawBarcode = BarcodeValue;
        if (string.IsNullOrWhiteSpace(rawBarcode))
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
            return;
        }

        if (await TryHandleLoadedBarcodeAsync(rawBarcode))
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Cerco il lotto anche tra quelli chiusi.", "info");
        var result = FlowService.AddLaunchFromBarcode(FlowState, ActionId, ProductionMode, rawBarcode, SelectedOrderIds, PrefillSelections.Values);
        BarcodeValue = string.Empty;
        if (!result.Success)
        {
            await LoadModelAsync(result.ValidationMessage, null);
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", result.ValidationMessage ?? "Barcode lotto non riconosciuto.");
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
            return;
        }

        SelectedOrderIds.Clear();
        foreach (var id in result.SelectedOrderIds)
        {
            SelectedOrderIds.Add(id);
        }

        PrefillSelections.Clear();
        foreach (var item in result.PrefillSelections)
        {
            PrefillSelections[item.OrderId] = item;
        }

        await PersistSelectionAsync(false);
        await LoadModelAsync(null, result.SuccessMessage);
        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
    }

    [JSInvokable(nameof(ProcessBarcodePasteAsync))]
    public async Task ProcessBarcodePasteAsync(string? rawBarcode)
    {
        BarcodeValue = rawBarcode ?? string.Empty;
        await AddBarcodeAsync();
        StateHasChanged();
    }

    private async Task<bool> TryHandleLoadedBarcodeAsync(string rawBarcode)
    {
        if (Model is null)
        {
            return false;
        }

        var matchingLaunches = FlowService.ResolveLoadedLaunchesFromBarcode(Model.Launches, rawBarcode);
        if (matchingLaunches.Count == 0)
        {
            return false;
        }

        BarcodeValue = string.Empty;
        if (matchingLaunches.Count > 1)
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Ho trovato pi\u00f9 lotti compatibili. Controlla il barcode e riprova.", "warning");
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
            return true;
        }

        var launch = matchingLaunches[0];
        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.scrollLaunchCardIntoView", launch.OrderId);

        if (AutoInsertOnBarcode && GetRemainingQuantity(launch) > 0)
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Lotto acquisito. Imposta qta e lotto, poi completa il timing in Schermata 4.", "success");
            OpenDirectModal(launch);
            return true;
        }

        if (SelectedOrderIds.Contains(launch.OrderId))
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Questo lotto \u00e8 gi\u00e0 selezionato.", "info");
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
            return true;
        }

        SelectedOrderIds.Add(launch.OrderId);
        await PersistSelectionAsync(false);
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Lotto aggiunto alla selezione.", "success");
        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "lotBarcode");
        return true;
    }

    private async Task ContinueAsync()
    {
        if (SelectedOrderIds.Count == 0)
        {
            ValidationMessage = "Per andare avanti devi avere almeno un lotto verde.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage);
            return;
        }

        await PersistSelectionAsync(false);
        Navigation.NavigateTo($"/blazor/screen4/{ActionId}");
    }

    private ProductionLaunchPrefillSelectionItem? GetPrefill(int orderId)
    {
        return PrefillSelections.TryGetValue(orderId, out var item) ? item : null;
    }

    private void OpenDirectModal(ProductionLaunchItemViewModel launch)
    {
        ActiveDirectLaunch = launch;
        var prefill = GetPrefill(launch.OrderId);
        DirectQuantity = prefill?.QuantityDeclared ?? string.Empty;
        DirectMaterialLotCode = prefill?.SelectedMaterialLotCode ?? string.Empty;
        if (string.IsNullOrWhiteSpace(DirectMaterialLotCode) && launch.AvailableMaterialLots.Count == 1)
        {
            DirectMaterialLotCode = launch.AvailableMaterialLots[0];
        }

        DirectPartialQuantity = DirectQuantity;
        ShowDirectPartialModal = false;
    }

    private string GetDirectMaterialLotHelpText()
    {
        if (ActiveDirectLaunch is null)
        {
            return "Seleziona il lotto toccando uno dei lotti disponibili.";
        }

        if (!string.IsNullOrWhiteSpace(ActiveDirectLaunch.MaterialLotValidationMessage))
        {
            return ActiveDirectLaunch.MaterialLotValidationMessage;
        }

        if (ActiveDirectLaunch.AvailableMaterialLots.Count == 0 && string.IsNullOrWhiteSpace(DirectMaterialLotCode))
        {
            return "Non ci sono lotti materiale disponibili per questo articolo. Puoi proseguire senza lotto.";
        }

        return string.IsNullOrWhiteSpace(DirectMaterialLotCode)
            ? "Seleziona il lotto toccando uno dei lotti disponibili."
            : "Lotto selezionato correttamente.";
    }

    private string GetDirectMaterialLotHelpClass()
    {
        var cssClass = "material-lot-scan-help";
        if (ActiveDirectLaunch is not null
            && !string.IsNullOrWhiteSpace(ActiveDirectLaunch.MaterialLotValidationMessage))
        {
            cssClass += " is-error";
        }
        else if (ActiveDirectLaunch is not null
            && ActiveDirectLaunch.AvailableMaterialLots.Count == 0
            && string.IsNullOrWhiteSpace(DirectMaterialLotCode))
        {
            cssClass += " is-error";
        }
        else if (!string.IsNullOrWhiteSpace(DirectMaterialLotCode))
        {
            cssClass += " is-success";
        }

        return cssClass;
    }

    private void SetDirectMaterialLot(string materialLot)
    {
        DirectMaterialLotCode = materialLot;
    }

    private void CloseDirectModal()
    {
        ActiveDirectLaunch = null;
        DirectQuantity = string.Empty;
        DirectPartialQuantity = string.Empty;
        DirectMaterialLotCode = string.Empty;
        ShowDirectPartialModal = false;
    }

    private ValueTask SyncModalStateAsync()
    {
        return JsRuntime.InvokeVoidAsync("molinaBlazorModal.setOpen", ActiveDirectLaunch is not null || ShowDirectPartialModal);
    }

    private void SetDirectMax()
    {
        if (ActiveDirectLaunch is null)
        {
            return;
        }

        DirectQuantity = FormatQuantity(GetRemainingQuantity(ActiveDirectLaunch));
    }

    private void OpenDirectPartialModal()
    {
        DirectPartialQuantity = DirectQuantity;
        ShowDirectPartialModal = true;
    }

    private void CloseDirectPartialModal()
    {
        ShowDirectPartialModal = false;
        DirectPartialQuantity = DirectQuantity;
    }

    private void ClearDirectPartialQuantity()
    {
        DirectPartialQuantity = string.Empty;
        DirectQuantity = string.Empty;
    }

    private void PressDirectPartialKey(string key)
    {
        if (key == "C")
        {
            DirectPartialQuantity = string.Empty;
            return;
        }

        if (key == "Del")
        {
            DirectPartialQuantity = DirectPartialQuantity.Length == 0 ? string.Empty : DirectPartialQuantity[..^1];
            return;
        }

        if (key == "," && DirectPartialQuantity.Contains(',', StringComparison.Ordinal))
        {
            return;
        }

        DirectPartialQuantity = key == "," && string.IsNullOrWhiteSpace(DirectPartialQuantity)
            ? "0,"
            : DirectPartialQuantity + key;
    }

    private async Task ConfirmDirectPartialQuantityAsync()
    {
        var value = ParseQuantity(DirectPartialQuantity);
        if (!value.HasValue || value.Value <= 0)
        {
            ValidationMessage = "Inserisci una qta dichiarata valida.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage);
            return;
        }

        DirectQuantity = FormatQuantity(value.Value);
        ShowDirectPartialModal = false;
    }

    private async Task ConfirmDirectInsertAsync()
    {
        if (ActiveDirectLaunch is null)
        {
            return;
        }

        var parsedQuantity = ParseQuantity(DirectQuantity);
        if (!parsedQuantity.HasValue || parsedQuantity.Value <= 0)
        {
            ValidationMessage = "Inserisci una qta dichiarata valida.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage);
            return;
        }

        if (Model?.RequiresMaterialLotSelection == true && string.IsNullOrWhiteSpace(DirectMaterialLotCode))
        {
            var singleLot = ActiveDirectLaunch.AvailableMaterialLots.Count == 1
                ? ActiveDirectLaunch.AvailableMaterialLots[0]
                : string.Empty;
            if (!string.IsNullOrWhiteSpace(singleLot))
            {
                DirectMaterialLotCode = singleLot;
            }
        }

        async Task FinalizeDirectInsertAsync()
        {
            SelectedOrderIds.Add(ActiveDirectLaunch.OrderId);
            PrefillSelections[ActiveDirectLaunch.OrderId] = new ProductionLaunchPrefillSelectionItem
            {
                OrderId = ActiveDirectLaunch.OrderId,
                QuantityDeclared = FormatQuantity(parsedQuantity.Value),
                SelectedMaterialLotCode = DirectMaterialLotCode?.Trim() ?? string.Empty
            };

            await PersistSelectionAsync(false);
            CloseDirectModal();
            await LoadModelAsync(null, null);
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Dati salvati in Schermata 3. Premi Avanti per completare il timing in Schermata 4.");
        }

        if (Model?.RequiresMaterialLotSelection == true
            && string.IsNullOrWhiteSpace(DirectMaterialLotCode)
            && ActiveDirectLaunch.AvailableMaterialLots.Count > 0)
        {
            var confirmed = await JsRuntime.InvokeAsync<bool>(
                "molinaBlazorDialog.confirm",
                "Ci sono lotti disponibili in giacenza. Vuoi proseguire comunque senza dichiarare il lotto materiale?",
                "Conferma senza lotto",
                "Prosegui senza lotto",
                "Torna ai dati",
                "!");
            if (!confirmed)
            {
                return;
            }
        }

        if (parsedQuantity.Value > GetRemainingQuantity(ActiveDirectLaunch))
        {
            var confirmed = await JsRuntime.InvokeAsync<bool>(
                "molinaBlazorDialog.confirm",
                "La qta dichiarata supera la qta residua disponibile per questo lotto. Tocca Conferma comunque solo se vuoi registrarla davvero.",
                "Conferma qta superiore al residuo",
                "Conferma comunque",
                "Torna ai dati",
                "!");
            if (!confirmed)
            {
                return;
            }
        }

        await FinalizeDirectInsertAsync();
    }

    private decimal GetRemainingQuantity(ProductionLaunchItemViewModel launch)
    {
        return Math.Max(launch.QuantityToProduce - (launch.QuantityProduced ?? 0m), 0m);
    }

    private static string FormatQuantity(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("it-IT"));
    }

    private static string FormatQuantityInvariant(decimal value)
    {
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private string GetSelectedOrderIdsValue()
    {
        return string.Join(',', SelectedOrderIds.OrderBy(static id => id));
    }

    private string SerializePrefillSelections()
    {
        return System.Text.Json.JsonSerializer.Serialize(PrefillSelections.Values
            .Where(static item => item.OrderId > 0)
            .OrderBy(static item => item.OrderId)
            .Select(static item => new ProductionLaunchPrefillSelectionItem
            {
                OrderId = item.OrderId,
                QuantityDeclared = item.QuantityDeclared ?? string.Empty,
                SelectedMaterialLotCode = item.SelectedMaterialLotCode?.Trim() ?? string.Empty
            }), new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            });
    }

    private static string FormatBool(bool value)
    {
        return value ? "true" : "false";
    }

    private static string EncodeMaterialLots(IReadOnlyCollection<string>? materialLots)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(materialLots ?? []);
        return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
    }

    private static string? GetDirectPartialKeypadValue(string key)
    {
        return key is "C" or "Del" ? null : key;
    }

    private static string? GetDirectPartialKeypadAction(string key)
    {
        return key switch
        {
            "C" => "clear",
            "Del" => "backspace",
            _ => null
        };
    }

    private static decimal? ParseQuantity(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return null;
        }

        var normalizedValue = rawValue
            .Trim()
            .Replace(" ", string.Empty)
            .Replace(",", ".");

        return decimal.TryParse(normalizedValue, NumberStyles.Number, CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
    }

    public async ValueTask DisposeAsync()
    {
        if (BarcodeReference is not null)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("molinaBlazorBarcode.deactivate", BarcodeReference);
            }
            catch (JSDisconnectedException)
            {
            }

            BarcodeReference.Dispose();
        }
    }
}
