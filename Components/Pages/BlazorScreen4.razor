@page "/blazor/screen4"
@page "/blazor/screen4/{ActionId}"
@inject NavigationManager Navigation
@inject BlazorProductionDeclarationState FlowState
@inject IProductionDeclarationFlowService FlowService
@inject IJSRuntime JsRuntime

<section class="page-section page-section--wide page-section--screen4"
         data-screen4-page="true"
         data-timing-only-mode="@(Model?.IsTimingOnlyMode.ToString().ToLowerInvariant() ?? "false")"
         data-requires-material-lot-selection="@(Model?.RequiresMaterialLotSelection.ToString().ToLowerInvariant() ?? "false")">
    <header class="page-header page-header--compact">
        <div>
            <div class="page-kicker">Schermata 4</div>
            <h1>@(Model?.ActionText ?? "Operazione")</h1>
            <p class="page-intro">@GetLineDisplayTitle()</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="inline-alert inline-alert--success" role="status">@SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ValidationMessage))
    {
        <div class="inline-alert" role="alert">@ValidationMessage</div>
    }

    @if (Model is null)
    {
        <div class="inline-alert">Caricamento operazione...</div>
    }
    else
    {
        <div id="screen4InsertForm">
            <div class="screen4-card screen4-card--table-layout">
                <div class="screen4-summary-bar screen4-summary-bar--screen4">
                    <div class="screen4-block screen4-block--summary">
                        <span class="note-label">Operatori selezionati</span>
                        <div class="selected-operators-list">
                            @foreach (var operatorItem in Model.SelectedOperators)
                            {
                                <span class="selected-operator-chip">@operatorItem.Name</span>
                            }
                        </div>
                    </div>

                    <div class="screen4-detail screen4-detail--date-global">
                        <span class="screen4-detail-label">Data</span>
                        <div class="screen4-date-box">
                            <input type="date"
                                   value="@Model.DeclarationDate.ToString("yyyy-MM-dd")"
                                   class="screen4-date-input"
                                   disabled="@(!Model.IsDeclarationDateEditable)"
                                   @onchange="OnDeclarationDateChanged" />
                            @if (Model.CanRequestDateEdit)
                            {
                                <button type="button" class="screen4-inline-button screen4-inline-button--secondary" @onclick="OpenDatePinModal">
                                    @(Model.IsDeclarationDateEditable ? "Data sbloccata" : "Modifica data")
                                </button>
                            }
                        </div>
                    </div>

                    @if (!Model.IsTimingOnlyMode)
                    {
                        <div class="screen4-detail screen4-detail--total-produced-global">
                            <span class="screen4-detail-label">Qta dichiarata</span>
                            <div class="screen4-total-produced-box">
                                <strong>@FormatQuantity(Model.TotalDeclared)</strong>
                            </div>
                        </div>
                    }

                    <div class="screen4-detail screen4-detail--timing-global">
                        <span class="screen4-detail-label">Timing totale</span>
                        <div class="screen4-global-timing-box">
                            <button type="button" class="screen4-inline-button screen4-inline-button--stacked" @onclick="OpenTimingModal">Timing</button>
                            <div class="screen4-time-display screen4-time-display--global">
                                <span>@FormatTime(Model.GlobalTimingHours, Model.GlobalTimingMinutes)</span>
                                @if (Model.GlobalTimingHours > 0 || Model.GlobalTimingMinutes > 0)
                                {
                                    <button type="button" class="screen4-summary-clear" title="Annulla timing" @onclick="ClearTimingAsync">×</button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (IsGenericDeclaration && SelectedNoteRequiresAnnotation)
                    {
                        <div class="screen4-detail screen4-detail--problem-global screen4-detail--note-description">
                            <span class="screen4-detail-label">Annotazione</span>
                            <div class="screen4-global-problem-box">
                                <textarea class="screen4-problem-textarea"
                                          rows="6"
                                          placeholder="Inserisci il testo annotazione"
                                          @bind="Model.GlobalProblemDescription"></textarea>
                            </div>
                        </div>
                    }

                    @if (!Model.IsTimingOnlyMode)
                    {
                        <div class="screen4-detail screen4-detail--problem-global">
                            <span class="screen4-detail-label">NOTE PRODUZIONE O BLOCCHI</span>
                            <div class="screen4-global-problem-box">
                                <button type="button" class="screen4-inline-button screen4-inline-button--warning screen4-inline-button--stacked" @onclick="OpenProblemModal">Inserisci nota Produzione o blocco</button>
                                <div class="screen4-problem-summary screen4-problem-summary--global@(ProblemNotes.Count > 0 ? " has-problem" : string.Empty)">
                                    <span>@GetProblemSummary()</span>
                                    @if (ProblemNotes.Count > 0)
                                    {
                                        <button type="button" class="screen4-summary-clear" title="Rimuovi note" @onclick="ClearProblemNotesAsync">×</button>
                                    }
                                </div>
                                @if (ProblemNotes.Count > 1)
                                {
                                    <div class="screen4-problem-list">
                                        @for (var index = 0; index < ProblemNotes.Count; index++)
                                        {
                                            var note = ProblemNotes[index];
                                            <div class="screen4-problem-list-item">
                                                <span>@FormatProblemNote(note)</span>
                                                <button type="button" class="screen4-summary-clear" @onclick="() => RemoveProblemNoteAsync(index)">×</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (Model.SelectedLaunches.Count > 0)
                {
                    <div class="screen4-block screen4-block--table">
                        <span class="note-label">Lotti selezionati</span>
                        <div class="screen4-table-wrap">
                            <table class="screen4-table screen4-table--wide">
                                <thead>
                                    <tr>
                                        <th>Lotto</th>
                                        <th>Numero Documento</th>
                                        <th>Fase</th>
                                        <th>Qta da produrre</th>
                                        <th>Qta prodotta</th>
                                        <th>Qta dichiarata</th>
                                        <th>Azioni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var launch in Model.SelectedLaunches)
                                    {
                                        <tr class="screen4-table-row" data-screen4-slot="true">
                                            <td data-label="Lotto" class="@GetLotCellClass(launch)" @onclick="() => OpenMaterialLotModalAsync(launch)">
                                                <div class="screen4-table-lot">@launch.LotCode</div>
                                                @if (!string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode))
                                                {
                                                    <button type="button" class="screen4-table-material-lot screen4-table-material-lot--editable">
                                                        @launch.SelectedMaterialLotCode
                                                    </button>
                                                }
                                            </td>
                                            <td data-label="Numero Documento"><div class="screen4-table-doc">@(!string.IsNullOrWhiteSpace(launch.DocumentNumber) ? launch.DocumentNumber : "-")</div></td>
                                            <td data-label="Fase"><div class="screen4-table-phase">&nbsp;</div></td>
                                            <td data-label="Qta da produrre"><div class="screen4-table-number">@FormatQuantity(launch.QuantityToProduce ?? 0m)</div></td>
                                            <td data-label="Qta prodotta"><strong class="screen4-table-number screen4-table-number--produced-readonly">@FormatQuantity(launch.QuantityProduced ?? 0m)</strong></td>
                                            <td data-label="Qta dichiarata"><strong class="screen4-table-number screen4-table-number--declared">@(launch.QuantityDeclared.HasValue ? FormatQuantity(launch.QuantityDeclared.Value) : "-")</strong></td>
                                            <td data-label="Azioni">
                                                <div class="screen4-slot-actions screen4-slot-actions--table">
                                                    <button type="button" class="screen4-slot-button screen4-slot-button--max" disabled="@(GetRemainingQuantity(launch) <= 0m)" @onclick="() => SetMaxQuantityAsync(launch)">Max</button>
                                                    @if (Model.RequiresMaterialLotSelection)
                                                    {
                                                        <button type="button" class="screen4-slot-button screen4-slot-button--history" @onclick="() => OpenMaterialLotModalAsync(launch)">Lotto</button>
                                                    }
                                                    @if ((launch.QuantityToProduce ?? 0m) != 1m)
                                                    {
                                                        <button type="button" class="screen4-slot-button screen4-slot-button--partial" disabled="@(GetRemainingQuantity(launch) <= 0m)" @onclick="() => OpenQuantityModal(launch)">Qta Parziale</button>
                                                    }
                                                    @if (launch.HasPreviousDeclarations)
                                                    {
                                                        <button type="button" class="screen4-slot-button screen4-slot-button--history" @onclick="() => ToggleHistory(launch.OrderId)">
                                                            @(ExpandedHistoryOrderIds.Contains(launch.OrderId) ? "Nascondi precedenti" : "Mostra precedenti")
                                                        </button>
                                                    }
                                                    <button type="button"
                                                            class="screen4-slot-clear screen4-slot-clear--table@(launch.QuantityDeclared.HasValue ? string.Empty : " is-hidden")"
                                                            aria-label="Annulla dati riga"
                                                            title="Annulla dati riga"
                                                            @onclick="() => ClearSlotAsync(launch)">
                                                        ×
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        @if (launch.HasPreviousDeclarations && ExpandedHistoryOrderIds.Contains(launch.OrderId))
                                        {
                                            <tr class="screen4-history-row">
                                                <td colspan="7">
                                                    <div class="screen4-history-wrap">
                                                        <div class="screen4-history-title">Dichiarazioni precedenti</div>
                                                        <div class="screen4-history-table-wrap">
                                                            <table class="screen4-history-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Data / ora</th>
                                                                        <th>Qta dichiarata</th>
                                                                        <th>Minuti lavorati</th>
                                                                        <th>Operatori</th>
                                                                        <th>Blocco / anomalia</th>
                                                                        <th>Minuti anomalia</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var history in launch.PreviousDeclarations)
                                                                    {
                                                                        <tr>
                                                                            <td class="screen4-history-datetime" title="@history.DeclarationDateTime.ToString("dd/MM/yyyy HH:mm")">
                                                                                <span class="screen4-history-date">@history.DeclarationDateTime.ToString("dd/MM/yyyy")</span>
                                                                                <span class="screen4-history-time">@history.DeclarationDateTime.ToString("HH:mm")</span>
                                                                            </td>
                                                                            <td>@FormatQuantity(history.DeclaredQuantity)</td>
                                                                            <td>@history.WorkedMinutes</td>
                                                                            <td>@(!string.IsNullOrWhiteSpace(history.OperatorsSummary) ? history.OperatorsSummary : "-")</td>
                                                                            <td>@(!string.IsNullOrWhiteSpace(history.AnomalyDescription) ? history.AnomalyDescription : "-")</td>
                                                                            <td>@(history.AnomalyMinutes > 0 ? history.AnomalyMinutes.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>

            <div class="form-footer form-footer--split">
                <button type="button" class="secondary-action-link" @onclick="GoBack">Indietro</button>
                @if (Model.SelectedLaunches.Count > 0 || Model.IsTimingOnlyMode)
                {
                    <button type="button"
                            id="screen4InsertButton"
                            class="primary-action-button"
                            hidden="@IsInsertButtonHidden"
                            disabled="@IsInsertButtonDisabled"
                            @onclick="InsertAsync">
                        Inserisci
                    </button>
                }
            </div>
        </div>
    }
</section>

@if (ShowDatePinModal)
{
    <div class="screen4-qty-modal" id="screen4DatePinModal">
        <div class="screen4-qty-modal__backdrop" @onclick="CloseDatePinModal"></div>
        <div class="screen4-qty-modal__dialog screen4-date-pin-modal" role="dialog" aria-modal="true" aria-labelledby="screen4DatePinModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Modifica data</div>
                    <h2 id="screen4DatePinModalTitle">Inserisci il PIN</h2>
                    <p class="screen4-date-pin-modal__intro">Per sbloccare la data usa il PIN dell'operatore abilitato.</p>
                </div>
                <button type="button" class="screen4-qty-modal__close" @onclick="CloseDatePinModal">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <label class="screen4-date-pin-modal__label" for="screen4DatePinInput">PIN operatore</label>
                <input type="password"
                       id="screen4DatePinInput"
                       class="screen4-date-pin-modal__input"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="off"
                       value="@DatePin"
                       @oninput="OnDatePinInput" />
                <div class="screen4-date-pin-modal__help">@DatePinMessage</div>
                <div class="screen4-qty-keypad screen4-date-pin-modal__keypad" aria-label="Tastierino numerico PIN">
                    @foreach (var key in PinKeys)
                    {
                        <button type="button" class="screen4-qty-key@(key is "C" or "Del" ? " screen4-qty-key--secondary" : string.Empty)" @onclick="() => PressDatePinKey(key)">
                            @(key == "Del" ? "⌫" : key)
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" @onclick="CloseDatePinModal">Chiudi</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" @onclick="ConfirmDatePinAsync">Conferma PIN</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ActiveQuantityLaunch is not null)
{
    <div class="screen4-qty-modal" id="screen4QuantityModal">
        <div class="screen4-qty-modal__backdrop" @onclick="CloseQuantityModal"></div>
        <div class="screen4-qty-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4QuantityModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Quantità parziale</div>
                    <h2 id="screen4QuantityModalTitle">Inserisci la quantità dichiarata</h2>
                    <p class="screen4-qty-modal__intro">Inserisci la qta dichiarata residua per il lotto selezionato.</p>
                </div>
                <button type="button" class="screen4-qty-modal__close" @onclick="CloseQuantityModal">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <div class="screen4-qty-modal__info">
                    <div class="screen4-qty-modal__info-box">
                        <span class="note-label">Qta residua</span>
                        <strong>@FormatQuantity(GetRemainingQuantity(ActiveQuantityLaunch))</strong>
                    </div>
                    <div class="screen4-qty-modal__info-box screen4-qty-modal__info-box--declared">
                        <span class="note-label">Qta dichiarata</span>
                        <strong>@(string.IsNullOrWhiteSpace(QuantityKeypadValue) ? "0" : QuantityKeypadValue)</strong>
                    </div>
                </div>
                <div class="screen4-qty-keypad">
                    @foreach (var key in QuantityKeys)
                    {
                        <button type="button" class="screen4-qty-key@(key is "C" or "Del" ? " screen4-qty-key--secondary" : string.Empty)" @onclick="() => PressQuantityKey(key)">
                            @(key == "Del" ? "⌫" : key)
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" @onclick="ClearActiveQuantityAsync">Annulla qta dichiarata</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" @onclick="CloseQuantityModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" @onclick="ConfirmQuantityAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ActiveMaterialLotLaunch is not null)
{
    <div class="screen4-qty-modal" id="screen4MaterialLotModal">
        <div class="screen4-qty-modal__backdrop" @onclick="CloseMaterialLotModal"></div>
        <div class="screen4-qty-modal__dialog screen4-material-lot-modal" role="dialog" aria-modal="true" aria-labelledby="screen4MaterialLotModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Lotto</div>
                    <h2 id="screen4MaterialLotModalTitle">Inserisci il lotto</h2>
                    <div class="material-lot-article-summary">
                        <span>@ActiveMaterialLotLaunch.ArticleCode</span>
                        <strong>@ActiveMaterialLotLaunch.ArticleDescription</strong>
                    </div>
                </div>
                <button type="button" class="screen4-qty-modal__close" @onclick="CloseMaterialLotModal">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <div class="@GetMaterialLotHelpClass()">@GetMaterialLotHelpText()</div>
                <div class="material-lot-reference-list" aria-label="Lotti disponibili">
                    @foreach (var materialLot in ActiveMaterialLotLaunch.AvailableMaterialLots)
                    {
                        <button type="button"
                                class="material-lot-reference-chip@(string.Equals(MaterialLotChoice, materialLot, StringComparison.OrdinalIgnoreCase) ? " is-selected" : string.Empty)"
                                aria-pressed="@(string.Equals(MaterialLotChoice, materialLot, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                @onclick="() => SetMaterialLotChoice(materialLot)">
                            @materialLot
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" @onclick="ClearMaterialLotChoice">Annulla lotto</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" @onclick="CloseMaterialLotModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" @onclick="ConfirmMaterialLotAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowTimingModal && Model is not null)
{
    <div class="screen4-time-modal" id="screen4TimingModal">
        <div class="screen4-qty-modal__backdrop" @onclick="CloseTimingModal"></div>
        <div class="screen4-qty-modal__dialog screen4-time-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4TimingModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Timing totale</div>
                    <h2 id="screen4TimingModalTitle">Inserisci il timing</h2>
                    <div class="screen4-modal-lot">Valido per tutti i lotti selezionati</div>
                </div>
                <button type="button" class="screen4-qty-modal__close" @onclick="CloseTimingModal">×</button>
            </div>
            <div class="screen4-time-display-panel">
                <div class="screen4-time-display-main">@FormatTime(Model.GlobalTimingHours, Model.GlobalTimingMinutes)</div>
            </div>
            <div class="screen4-time-grid">
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Ore</div>
                    <div class="screen4-time-hours-controls">
                        <button type="button" class="screen4-time-adjust" @onclick="() => AdjustTimingHours(-1)">−1 ora</button>
                        <div class="screen4-time-value-box">@Model.GlobalTimingHours</div>
                        <button type="button" class="screen4-time-adjust" @onclick="() => AdjustTimingHours(1)">+1 ora</button>
                    </div>
                </div>
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Minuti</div>
                    <div class="screen4-minute-options screen4-minute-options--timing">
                        @foreach (var minute in MinuteOptions)
                        {
                            <button type="button" class="screen4-minute-option@(Model.GlobalTimingMinutes == minute ? " is-active" : string.Empty)" @onclick="() => Model.GlobalTimingMinutes = minute">@FormatMinuteOption(minute)</button>
                        }
                    </div>
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" @onclick="ClearTimingAsync">Annulla timing</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" @onclick="CloseTimingModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" @onclick="ConfirmTimingAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowProblemModal && Model is not null)
{
    <div class="screen4-time-modal" id="screen4ProblemModal">
        <div class="screen4-qty-modal__backdrop" @onclick="CloseProblemModal"></div>
        <div class="screen4-qty-modal__dialog screen4-time-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4ProblemModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Note produzione o blocchi</div>
                    <h2 id="screen4ProblemModalTitle">NOTE PRODUZIONE O BLOCCHI</h2>
                    <div class="screen4-modal-lot">Valido per tutti i lotti selezionati</div>
                </div>
                <button type="button" class="screen4-qty-modal__close" @onclick="CloseProblemModal">×</button>
            </div>

            <div class="screen4-problem-note-type">
                <div class="screen4-problem-label">Tipo nota</div>
                <div class="screen4-note-type-buttons" role="group">
                    @foreach (var noteType in Model.AvailableNoteTypes)
                    {
                        var isSelected = ProblemNoteTypeId == noteType.Id;
                        <button type="button"
                                class="screen4-note-type-button@(isSelected ? " is-selected" : string.Empty)"
                                @onclick="() => ProblemNoteTypeId = noteType.Id">
                            @noteType.Description
                        </button>
                    }
                </div>
            </div>

            @if (ProblemSelectedNoteRequiresAnnotation)
            {
                <div class="screen4-problem-editor">
                    <label class="screen4-problem-label" for="screen4ProblemDescription">Descrizione blocco o anomalia</label>
                    <textarea id="screen4ProblemDescription" class="screen4-problem-textarea" rows="4" placeholder="Scrivi il blocco o l'anomalia riscontrata" @bind="ProblemDescription"></textarea>
                </div>
            }

            <div class="screen4-time-display-panel screen4-time-display-panel--problem">
                <div class="screen4-time-display-main">@FormatTime(ProblemHours, ProblemMinutes)</div>
            </div>
            <div class="screen4-time-grid">
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Ore</div>
                    <div class="screen4-time-hours-controls">
                        <button type="button" class="screen4-time-adjust" @onclick="() => ProblemHours = Math.Max(0, ProblemHours - 1)">−1 ora</button>
                        <div class="screen4-time-value-box">@ProblemHours</div>
                        <button type="button" class="screen4-time-adjust" @onclick="() => ProblemHours++">+1 ora</button>
                    </div>
                </div>
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Minuti</div>
                    <div class="screen4-minute-options screen4-minute-options--problem">
                        @foreach (var minute in MinuteOptions)
                        {
                            <button type="button" class="screen4-minute-option@(ProblemMinutes == minute ? " is-active" : string.Empty)" @onclick="() => ProblemMinutes = minute">@FormatMinuteOption(minute)</button>
                        }
                    </div>
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" @onclick="ClearProblemDraftAsync">Annulla</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" @onclick="CloseProblemModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" @onclick="ConfirmProblemNoteAsync">Aggiungi</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ActionId { get; set; }

    private static readonly string[] QuantityKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "Del", ","];
