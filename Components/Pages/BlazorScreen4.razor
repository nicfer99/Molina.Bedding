    private string GetProblemSummary()
    {
        if (ProblemNotes.Count == 0)
        {
            return "Nessuna nota produzione o blocco";
        }

        return ProblemNotes.Count == 1
            ? FormatProblemNote(ProblemNotes[0])
            : $"{ProblemNotes.Count} note produzione o blocchi";
    }

    private string FormatProblemNote(Screen4ProblemNotePostItemModel note)
    {
        var noteType = Model?.AvailableNoteTypes.FirstOrDefault(item => item.Id == note.NoteTypeId)?.Description ?? "Nota";
        var description = string.IsNullOrWhiteSpace(note.Description) ? string.Empty : $" - {note.Description}";
        return $"{noteType}: {FormatTime(note.Hours, note.Minutes)}{description}";
    }

