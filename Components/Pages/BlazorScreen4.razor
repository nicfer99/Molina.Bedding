@page "/blazor/screen4"
@page "/blazor/screen4/{ActionId}"
@inject NavigationManager Navigation
@inject BlazorProductionDeclarationState FlowState
@inject IProductionDeclarationFlowService FlowService
@inject IJSRuntime JsRuntime

<section class="page-section page-section--wide page-section--screen4"
         data-screen4-page="true"
         data-timing-only-mode="@(Model?.IsTimingOnlyMode.ToString().ToLowerInvariant() ?? "false")"
         data-requires-material-lot-selection="@(Model?.RequiresMaterialLotSelection.ToString().ToLowerInvariant() ?? "false")"
         data-auto-fill-max-from-barcode="@(Model?.AutoFillMaxQuantityFromBarcode.ToString().ToLowerInvariant() ?? "false")">
    <header class="page-header page-header--compact">
        <div>
            <div class="page-kicker">Schermata 4</div>
            <h1>@(Model?.ActionText ?? "Operazione")</h1>
            <p class="page-intro">@GetLineDisplayTitle()</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="inline-alert inline-alert--success" role="status">@SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ValidationMessage))
    {
        <div class="inline-alert" role="alert">@ValidationMessage</div>
    }

    @if (Model is null)
    {
        <div class="inline-alert">Caricamento operazione...</div>
    }
    else
    {
        <div id="screen4InsertForm">
            <input type="hidden" name="ActionId" value="@Model.ActionId" />
            <input type="hidden" name="ProductionMode" value="@Model.ProductionMode" />
            <input type="hidden" name="ConfirmedOverLimitOrderIds" value="@string.Join(",", ConfirmedOverLimitOrderIds.OrderBy(id => id))" data-confirmed-over-limit-hidden="true" />
            <input type="hidden" name="ConfirmedMissingMaterialLotOrderIds" value="@string.Join(",", ConfirmedMissingMaterialLotOrderIds.OrderBy(id => id))" data-confirmed-missing-material-lot-hidden="true" />
            <input type="hidden" name="DeclarationDate" value="@Model.DeclarationDate.ToString("yyyy-MM-dd")" data-declaration-date-hidden="true" />
            <div class="screen4-card screen4-card--table-layout">
                <div class="screen4-summary-bar screen4-summary-bar--screen4">
                    <div class="screen4-block screen4-block--summary">
                        <span class="note-label">Operatori selezionati</span>
                        <div class="selected-operators-list">
                            @foreach (var operatorItem in Model.SelectedOperators)
                            {
                                <span class="selected-operator-chip">@operatorItem.Name</span>
                            }
                        </div>
                    </div>

                    <div class="screen4-detail screen4-detail--date-global">
                        <span class="screen4-detail-label">Data</span>
                        <div class="screen4-date-box">
                            <input type="date"
                                   id="screen4DeclarationDateInput"
                                   value="@Model.DeclarationDate.ToString("yyyy-MM-dd")"
                                   class="screen4-date-input"
                                   data-declaration-date-input="true"
                                   disabled="@(!Model.IsDeclarationDateEditable)"
                                   @onchange="OnDeclarationDateChanged" />
                            @if (Model.CanRequestDateEdit)
                            {
                                <button type="button" class="screen4-inline-button screen4-inline-button--secondary" data-request-date-edit="true" @onclick="RequestDateEditAsync">
                                    @(Model.IsDeclarationDateEditable ? "Data sbloccata" : "Modifica data")
                                </button>
                            }
                        </div>
                    </div>

                    @if (!Model.IsTimingOnlyMode)
                    {
                        <div class="screen4-detail screen4-detail--total-produced-global">
                            <span class="screen4-detail-label">Qta dichiarata</span>
                            <div class="screen4-total-produced-box">
                                <strong data-total-declared-value="true">@FormatQuantity(Model.TotalDeclared)</strong>
                            </div>
                        </div>
                    }

                    <div class="screen4-detail screen4-detail--timing-global">
                        <span class="screen4-detail-label">Timing totale</span>
                        <div class="screen4-global-timing-box">
                            <button type="button" class="screen4-inline-button screen4-inline-button--stacked" data-open-global-timing="true" @onclick="OpenTimingModal">Timing</button>
                            <div class="screen4-time-display screen4-time-display--global" data-global-timing-display="true">
                                <span data-global-timing-text="true">@FormatTime(Model.GlobalTimingHours, Model.GlobalTimingMinutes)</span>
                                <button type="button"
                                        class="screen4-summary-clear@((Model.GlobalTimingHours > 0 || Model.GlobalTimingMinutes > 0) ? string.Empty : " is-hidden")"
                                        data-clear-global-timing="true"
                                        aria-label="Annulla timing"
                                        title="Annulla timing"
                                        @onclick="ClearTimingAsync">×</button>
                            </div>
                            <input type="hidden" name="GlobalTimingHours" value="@Model.GlobalTimingHours" data-global-timing-hours-hidden="true" />
                            <input type="hidden" name="GlobalTimingMinutes" value="@Model.GlobalTimingMinutes" data-global-timing-minutes-hidden="true" />
                        </div>
                    </div>

                    @if (IsGenericDeclaration && Model.SelectedNoteTypeId.HasValue)
                    {
                        <input type="hidden" name="SelectedNoteTypeId" value="@Model.SelectedNoteTypeId.Value" />
                    }

                    @if (IsGenericDeclaration && SelectedNoteRequiresAnnotation)
                    {
                        <div class="screen4-detail screen4-detail--problem-global screen4-detail--note-description" data-note-description-field="true">
                            <span class="screen4-detail-label">Annotazione</span>
                            <div class="screen4-global-problem-box">
                                <textarea name="GlobalProblemDescription"
                                          class="screen4-problem-textarea"
                                          data-note-description-input="true"
                                          rows="6"
                                          placeholder="Inserisci il testo annotazione"
                                          @bind="Model.GlobalProblemDescription"></textarea>
                            </div>
                        </div>
                    }

                    @if (!Model.IsTimingOnlyMode)
                    {
                        <div class="screen4-detail screen4-detail--problem-global">
                            <span class="screen4-detail-label">NOTE PRODUZIONE O BLOCCHI</span>
                            <div class="screen4-global-problem-box">
                                <button type="button" class="screen4-inline-button screen4-inline-button--warning screen4-inline-button--stacked" data-open-global-problem="true" @onclick="OpenProblemModal">Inserisci nota Produzione o blocco</button>
                                <div class="screen4-problem-summary screen4-problem-summary--global@(ProblemNotes.Count > 0 ? " has-problem" : string.Empty)" data-global-problem-summary="true">
                                    <span data-global-problem-summary-text="true">@GetProblemSummary()</span>
                                    <button type="button"
                                            class="screen4-summary-clear@(ProblemNotes.Count > 0 ? string.Empty : " is-hidden")"
                                            data-clear-global-problem="true"
                                            aria-label="Rimuovi nota produzione o blocco"
                                            title="Rimuovi nota produzione o blocco"
                                            @onclick="ClearProblemNotesAsync">×</button>
                                </div>
                                <input type="hidden" name="GlobalProblemDescription" value="@Model.GlobalProblemDescription" data-global-problem-description-hidden="true" />
                                <input type="hidden" name="GlobalProblemHours" value="@Model.GlobalProblemHours" data-global-problem-hours-hidden="true" />
                                <input type="hidden" name="GlobalProblemMinutes" value="@Model.GlobalProblemMinutes" data-global-problem-minutes-hidden="true" />
                                <input type="hidden" name="ProblemNotesJson" value="@JsonSerializer.Serialize(ProblemNotes)" data-problem-notes-hidden="true" />
                                <div class="screen4-problem-list" data-problem-notes-list="true" hidden="@(ProblemNotes.Count <= 1)">
                                    @for (var index = 0; index < ProblemNotes.Count; index++)
                                    {
                                        var note = ProblemNotes[index];
                                        <div class="screen4-problem-list-item">
                                            <span>@FormatProblemNote(note)</span>
                                            <button type="button"
                                                    class="screen4-summary-clear"
                                                    data-remove-problem-note-index="@index"
                                                    aria-label="Rimuovi nota produzione o blocco"
                                                    title="Rimuovi nota produzione o blocco"
                                                    @onclick="() => RemoveProblemNoteAsync(index)">x</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.SelectedLaunches.Count > 0)
                {
                    <div class="screen4-block screen4-block--table">
                        <span class="note-label">Lotti selezionati</span>
                        <div class="screen4-table-wrap">
                            <table class="screen4-table screen4-table--wide">
                                <thead>
                                    <tr>
                                        <th>Lotto</th>
                                        <th>Numero Documento</th>
                                        <th>Fase</th>
                                        <th>Qta da produrre</th>
                                        <th>Qta prodotta</th>
                                        <th>Qta dichiarata</th>
                                        <th>Azioni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var index = 0; index < Model.SelectedLaunches.Count; index++)
                                    {
                                        var launch = Model.SelectedLaunches[index];
                                        var historyRowId = $"screen4History{index}";
                                        var materialLotsJson = JsonSerializer.Serialize(launch.AvailableMaterialLots ?? []);
                                        var materialLotsBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(materialLotsJson));
                                        <tr class="screen4-table-row"
                                            data-screen4-slot="true"
                                            data-order-id="@launch.OrderId"
                                            data-slot-index="@index"
                                            data-max-qty="@FormatQuantityInvariant(launch.QuantityToProduce ?? 0m)"
                                            data-produced-qty="@FormatQuantityInvariant(launch.QuantityProduced ?? 0m)"
                                            data-remaining-qty="@FormatQuantityInvariant(GetRemainingQuantity(launch))"
                                            data-lot-code="@launch.LotCode"
                                            data-article-code="@launch.ArticleCode"
                                            data-article-description="@launch.ArticleDescription"
                                            data-material-lots-base64="@materialLotsBase64"
                                            data-material-lot-error="@launch.MaterialLotValidationMessage">
                                            <td data-label="Lotto"
                                                class="@GetLotCellClass(launch)"
                                                data-edit-material-lot-cell="@(Model.RequiresMaterialLotSelection ? "true" : null)"
                                                tabindex="@(Model.RequiresMaterialLotSelection ? "0" : null)"
                                                role="@(Model.RequiresMaterialLotSelection ? "button" : null)"
                                                aria-label="@(Model.RequiresMaterialLotSelection ? "Apri selezione lotto per questa riga" : null)"
                                                @onclick="() => OpenMaterialLotModalAsync(launch)">
                                                <div class="screen4-table-lot">@launch.LotCode</div>
                                                <button type="button"
                                                        class="screen4-table-material-lot screen4-table-material-lot--editable@(string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode) ? " is-hidden" : string.Empty)"
                                                        data-material-lot-display="true"
                                                        data-edit-material-lot-trigger="true"
                                                        title="Modifica il lotto selezionato"
                                                        aria-label="Modifica il lotto selezionato">
                                                    @launch.SelectedMaterialLotCode
                                                </button>
                                            </td>
                                            <td data-label="Numero Documento"><div class="screen4-table-doc">@(!string.IsNullOrWhiteSpace(launch.DocumentNumber) ? launch.DocumentNumber : "-")</div></td>
                                            <td data-label="Fase"><div class="screen4-table-phase">&nbsp;</div></td>
                                            <td data-label="Qta da produrre"><div class="screen4-table-number" data-max-value="true">@(launch.QuantityToProduce.HasValue ? FormatQuantity(launch.QuantityToProduce.Value) : "-")</div></td>
                                            <td data-label="Qta prodotta">
                                                <div class="screen4-produced-cell">
                                                    <strong class="screen4-table-number screen4-table-number--produced-readonly">@FormatQuantity(launch.QuantityProduced ?? 0m)</strong>
                                                </div>
                                            </td>
                                            <td data-label="Qta dichiarata">
                                                <div class="screen4-produced-cell">
                                                    <strong class="screen4-table-number screen4-table-number--declared" data-declared-value="true">@(launch.QuantityDeclared.HasValue ? FormatQuantity(launch.QuantityDeclared.Value) : "-")</strong>
                                                </div>
                                                <input type="hidden" name="Rows[@index].OrderId" value="@launch.OrderId" />
                                                <input type="hidden" name="Rows[@index].QuantityDeclared" value="@(launch.QuantityDeclared.HasValue ? FormatQuantityInvariant(launch.QuantityDeclared.Value) : string.Empty)" data-declared-hidden="true" />
                                                <input type="hidden" name="Rows[@index].SelectedMaterialLotCode" value="@launch.SelectedMaterialLotCode" data-material-lot-hidden="true" />
                                            </td>
                                            <td data-label="Azioni">
                                                <div class="screen4-slot-actions screen4-slot-actions--table">
                                                    <button type="button"
                                                            class="screen4-slot-button screen4-slot-button--max"
                                                            data-set-max="true"
                                                            title="@(GetRemainingQuantity(launch) <= 0m ? "Quantità già completata" : "Imposta la qta massima residua")"
                                                            disabled="@(GetRemainingQuantity(launch) <= 0m)"
                                                            @onclick="() => SetMaxQuantityAsync(launch)">Max</button>
                                                    @if (Model.RequiresMaterialLotSelection)
                                                    {
                                                        <button type="button"
                                                                class="screen4-slot-button screen4-slot-button--history"
                                                                data-edit-material-lot="true"
                                                                title="Seleziona o modifica il lotto"
                                                                @onclick="() => OpenMaterialLotModalAsync(launch)">Lotto</button>
                                                    }
                                                    @if ((launch.QuantityToProduce ?? 0m) != 1m)
                                                    {
                                                        <button type="button"
                                                                class="screen4-slot-button screen4-slot-button--partial"
                                                                data-set-partial="true"
                                                                title="@(GetRemainingQuantity(launch) <= 0m ? "Quantità già completata" : "Inserisci una qta parziale residua")"
                                                                disabled="@(GetRemainingQuantity(launch) <= 0m)"
                                                                @onclick="() => OpenQuantityModal(launch)">Qta Parziale</button>
                                                    }
                                                    @if (launch.HasPreviousDeclarations)
                                                    {
                                                        <button type="button"
                                                                class="screen4-slot-button screen4-slot-button--history"
                                                                data-toggle-history="true"
                                                                data-history-target="@historyRowId"
                                                                aria-expanded="@(ExpandedHistoryOrderIds.Contains(launch.OrderId) ? "true" : "false")"
                                                                @onclick="() => ToggleHistory(launch.OrderId)">
                                                            @(ExpandedHistoryOrderIds.Contains(launch.OrderId) ? "Nascondi precedenti" : "Mostra precedenti")
                                                        </button>
                                                    }
                                                    <button type="button"
                                                            class="screen4-slot-clear screen4-slot-clear--table@(launch.QuantityDeclared.HasValue ? string.Empty : " is-hidden")"
                                                            data-clear-slot="true"
                                                            aria-label="Annulla dati riga"
                                                            title="Annulla dati riga"
                                                            @onclick="() => ClearSlotAsync(launch)">
                                                        ×
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        @if (launch.HasPreviousDeclarations)
                                        {
                                            <tr class="screen4-history-row@(ExpandedHistoryOrderIds.Contains(launch.OrderId) ? string.Empty : " is-hidden")" id="@historyRowId" data-history-row="true">
                                                <td colspan="7">
                                                    <div class="screen4-history-wrap">
                                                        <div class="screen4-history-title">Dichiarazioni precedenti</div>
                                                        <div class="screen4-history-table-wrap">
                                                            <table class="screen4-history-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Data / ora</th>
                                                                        <th>Qta dichiarata</th>
                                                                        <th>Minuti lavorati</th>
                                                                        <th>Operatori</th>
                                                                        <th>Blocco / anomalia</th>
                                                                        <th>Minuti anomalia</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var history in launch.PreviousDeclarations)
                                                                    {
                                                                        <tr>
                                                                            <td class="screen4-history-datetime" title="@history.DeclarationDateTime.ToString("dd/MM/yyyy HH:mm")">
                                                                                <span class="screen4-history-date">@history.DeclarationDateTime.ToString("dd/MM/yyyy")</span>
                                                                                <span class="screen4-history-time">@history.DeclarationDateTime.ToString("HH:mm")</span>
                                                                            </td>
                                                                            <td>@FormatQuantity(history.DeclaredQuantity)</td>
                                                                            <td>@history.WorkedMinutes</td>
                                                                            <td>@(!string.IsNullOrWhiteSpace(history.OperatorsSummary) ? history.OperatorsSummary : "-")</td>
                                                                            <td>@(!string.IsNullOrWhiteSpace(history.AnomalyDescription) ? history.AnomalyDescription : "-")</td>
                                                                            <td>@(history.AnomalyMinutes > 0 ? history.AnomalyMinutes.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>

            <div class="form-footer form-footer--split">
                <a href="@GetBackUrl()" class="secondary-action-link">Indietro</a>
                @if (Model.SelectedLaunches.Count > 0 || Model.IsTimingOnlyMode)
                {
                    <button type="button"
                            id="screen4InsertButton"
                            class="primary-action-button"
                            hidden="@IsInsertButtonHidden"
                            disabled="@IsInsertButtonDisabled"
                            @onclick="InsertAsync">
                        Inserisci
                    </button>
                }
            </div>
        </div>
    }
</section>

<div class="screen4-qty-modal" id="screen4DatePinModal" hidden="@(!ShowDatePinModal)">
        <div class="screen4-qty-modal__backdrop" data-close-date-pin-modal="true" @onclick="CloseDatePinModal"></div>
        <div class="screen4-qty-modal__dialog screen4-date-pin-modal" role="dialog" aria-modal="true" aria-labelledby="screen4DatePinModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Modifica data</div>
                    <h2 id="screen4DatePinModalTitle">Inserisci il PIN</h2>
                    <p class="screen4-date-pin-modal__intro">Per sbloccare la data usa il PIN dell'operatore abilitato.</p>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-date-pin-modal="true" @onclick="CloseDatePinModal" aria-label="Chiudi finestra">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <label class="screen4-date-pin-modal__label" for="screen4DatePinInput">PIN operatore</label>
                <input type="password"
                       id="screen4DatePinInput"
                       class="screen4-date-pin-modal__input"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       autocomplete="off"
                       value="@DatePin"
                       @oninput="OnDatePinInput"
                       @onkeydown="HandleDatePinKeydownAsync" />
                <div class="screen4-date-pin-modal__help" id="screen4DatePinHelp">@DatePinMessage</div>
                <div class="screen4-qty-keypad screen4-date-pin-modal__keypad" aria-label="Tastierino numerico PIN">
                    @foreach (var key in PinKeys)
                    {
                        <button type="button"
                                class="screen4-qty-key@(key is "C" or "Del" ? " screen4-qty-key--secondary" : string.Empty)"
                                data-date-pin-keypad-value="@GetKeypadValue(key)"
                                data-date-pin-keypad-action="@GetKeypadAction(key)"
                                @onclick="() => PressDatePinKeyAsync(key)">
                            @(key == "Del" ? "⌫" : key)
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-date-pin-modal="true" @onclick="CloseDatePinModal">Chiudi</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-date-pin="true" @onclick="ConfirmDatePinAsync">Conferma PIN</button>
                </div>
            </div>
        </div>
    </div>

@if (Model is not null)
{
    <div class="screen4-qty-modal" id="screen4QuantityModal" hidden="@(ActiveQuantityLaunch is null)">
        <div class="screen4-qty-modal__backdrop" data-close-qty-modal="true" @onclick="CloseQuantityModal"></div>
        <div class="screen4-qty-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4QuantityModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker" data-qty-modal-kicker="true">Quantità parziale</div>
                    <h2 id="screen4QuantityModalTitle" data-qty-modal-title="true">Inserisci la quantità dichiarata</h2>
                    <p class="screen4-qty-modal__intro" data-qty-modal-intro="true">Inserisci la qta dichiarata residua per il lotto selezionato.</p>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-qty-modal="true" @onclick="CloseQuantityModal" aria-label="Chiudi finestra">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <div class="screen4-qty-modal__info">
                    <div class="screen4-qty-modal__info-box">
                        <span class="note-label" id="screen4QtyModalReferenceLabel">Qta residua</span>
                        <strong id="screen4QtyModalMax">@(ActiveQuantityLaunch is null ? "0" : FormatQuantity(GetRemainingQuantity(ActiveQuantityLaunch)))</strong>
                    </div>
                    <div class="screen4-qty-modal__info-box screen4-qty-modal__info-box--declared">
                        <span class="note-label">Qta dichiarata</span>
                        <strong id="screen4QtyModalDisplay">@(string.IsNullOrWhiteSpace(QuantityKeypadValue) ? "0" : QuantityKeypadValue)</strong>
                    </div>
                </div>
                <div class="screen4-qty-keypad">
                    @foreach (var key in QuantityKeys)
                    {
                        <button type="button"
                                class="screen4-qty-key@(key is "C" or "Del" ? " screen4-qty-key--secondary" : string.Empty)"
                                data-keypad-value="@GetKeypadValue(key)"
                                data-keypad-action="@GetKeypadAction(key)"
                                @onclick="() => PressQuantityKey(key)">
                            @(key == "Del" ? "⌫" : key)
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-clear-current-qty="true" @onclick="ClearActiveQuantityAsync">Annulla qta dichiarata</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-qty-modal="true" @onclick="CloseQuantityModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-qty="true" @onclick="ConfirmQuantityAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>

    <div class="screen4-qty-modal" id="screen4MaterialLotModal" hidden="@(ActiveMaterialLotLaunch is null)">
        <div class="screen4-qty-modal__backdrop" data-close-material-lot-modal="true" @onclick="CloseMaterialLotModal"></div>
        <div class="screen4-qty-modal__dialog screen4-material-lot-modal" role="dialog" aria-modal="true" aria-labelledby="screen4MaterialLotModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Lotto</div>
                    <h2 id="screen4MaterialLotModalTitle">Inserisci il lotto</h2>
                    <div class="material-lot-article-summary" data-material-lot-article-summary="true">
                        <span data-material-lot-article-code="true">@(ActiveMaterialLotLaunch?.ArticleCode ?? "-")</span>
                        <strong data-material-lot-article-description="true">@(ActiveMaterialLotLaunch?.ArticleDescription ?? "-")</strong>
                    </div>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-material-lot-modal="true" @onclick="CloseMaterialLotModal" aria-label="Chiudi finestra">×</button>
            </div>
            <div class="screen4-qty-modal__content">
                <input type="hidden" id="screen4MaterialLotInput" value="@MaterialLotChoice" />
                <div class="@GetMaterialLotHelpClass()" id="screen4MaterialLotHelp">@GetMaterialLotHelpText()</div>
                <div class="material-lot-reference-list" data-material-lot-list="true" aria-label="Lotti disponibili">
                    @foreach (var materialLot in ActiveMaterialLotLaunch?.AvailableMaterialLots ?? System.Linq.Enumerable.Empty<string>())
                    {
                        <button type="button"
                                class="material-lot-reference-chip@(string.Equals(MaterialLotChoice, materialLot, StringComparison.OrdinalIgnoreCase) ? " is-selected" : string.Empty)"
                                data-material-lot-reference="@materialLot"
                                aria-pressed="@(string.Equals(MaterialLotChoice, materialLot, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                @onclick="() => SetMaterialLotChoice(materialLot)">
                            @materialLot
                        </button>
                    }
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-clear-material-lot="true" @onclick="ClearMaterialLotChoice">Annulla lotto</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-material-lot-modal="true" @onclick="CloseMaterialLotModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-material-lot="true" @onclick="ConfirmMaterialLotAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>

    <div class="screen4-time-modal" id="screen4TimingModal" hidden="@(!ShowTimingModal)">
        <div class="screen4-qty-modal__backdrop" data-close-timing-modal="true" @onclick="CloseTimingModal"></div>
        <div class="screen4-qty-modal__dialog screen4-time-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4TimingModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Timing totale</div>
                    <h2 id="screen4TimingModalTitle">Inserisci il timing</h2>
                    <div class="screen4-modal-lot" id="screen4TimingModalLot">Valido per tutti i lotti selezionati</div>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-timing-modal="true" @onclick="CloseTimingModal" aria-label="Chiudi finestra">×</button>
            </div>
            <div class="screen4-time-display-panel">
                <div class="screen4-time-display-main" id="screen4TimingModalDisplay">@FormatTime(TimingHoursDraft, TimingMinutesDraft)</div>
            </div>
            <div class="screen4-time-grid">
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Ore</div>
                    <div class="screen4-time-hours-controls">
                        <button type="button" class="screen4-time-adjust" data-timing-hours-adjust="-1" @onclick="() => AdjustTimingHours(-1)">−1 ora</button>
                        <div class="screen4-time-value-box" id="screen4TimingHoursValue">@TimingHoursDraft</div>
                        <button type="button" class="screen4-time-adjust" data-timing-hours-adjust="1" @onclick="() => AdjustTimingHours(1)">+1 ora</button>
                    </div>
                </div>
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Minuti</div>
                    <div class="screen4-minute-options screen4-minute-options--timing">
                        @foreach (var minute in MinuteOptions)
                        {
                            <button type="button"
                                    class="screen4-minute-option@(TimingMinutesDraft == minute ? " is-active" : string.Empty)"
                                    data-timing-minute-value="@minute"
                                    @onclick="() => TimingMinutesDraft = minute">@FormatMinuteOption(minute)</button>
                        }
                    </div>
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-clear-timing="true" @onclick="ClearTimingAsync">Annulla timing</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-timing-modal="true" @onclick="CloseTimingModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-timing="true" @onclick="ConfirmTimingAsync">Conferma</button>
                </div>
            </div>
        </div>
    </div>

    <div class="screen4-time-modal" id="screen4ProblemModal" hidden="@(!ShowProblemModal)">
        <div class="screen4-qty-modal__backdrop" data-close-problem-modal="true" @onclick="CloseProblemModal"></div>
        <div class="screen4-qty-modal__dialog screen4-time-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="screen4ProblemModalTitle">
            <div class="screen4-qty-modal__header">
                <div>
                    <div class="page-kicker">Note produzione o blocchi</div>
                    <h2 id="screen4ProblemModalTitle">NOTE PRODUZIONE O BLOCCHI</h2>
                    <div class="screen4-modal-lot" id="screen4ProblemModalLot">Valido per tutti i lotti selezionati</div>
                </div>
                <button type="button" class="screen4-qty-modal__close" data-close-problem-modal="true" @onclick="CloseProblemModal" aria-label="Chiudi finestra">×</button>
            </div>

            @if (ShowClassicNoteTypeSelect)
            {
                <div class="screen4-problem-note-type">
                    <div class="screen4-problem-label" id="screen4ProblemNoteTypeLabel">Tipo nota</div>
                    <select id="screen4ProblemNoteType"
                            class="screen4-date-input screen4-note-type-select"
                            data-note-type-select="true"
                            value="@ProblemNoteTypeId"
                            hidden>
                        <option value="">Seleziona tipo nota</option>
                        @foreach (var noteType in Model.AvailableNoteTypes)
                        {
                            <option value="@noteType.Id"
                                    data-requires-annotation="@FormatBool(noteType.RequiresAnnotationText)"
                                    selected="@(ProblemNoteTypeId == noteType.Id ? "selected" : null)">
                                @noteType.Description
                            </option>
                        }
                    </select>
                    <div class="screen4-note-type-buttons" role="group" aria-labelledby="screen4ProblemNoteTypeLabel">
                        @foreach (var noteType in Model.AvailableNoteTypes)
                        {
                            var isSelected = ProblemNoteTypeId == noteType.Id;
                            <button type="button"
                                    class="screen4-note-type-button@(isSelected ? " is-selected" : string.Empty)"
                                    data-note-type-button="true"
                                    data-note-type-id="@noteType.Id"
                                    data-requires-annotation="@FormatBool(noteType.RequiresAnnotationText)"
                                    aria-pressed="@(isSelected ? "true" : "false")"
                                    @onclick="() => ProblemNoteTypeId = noteType.Id">
                                @noteType.Description
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="screen4-problem-editor" data-note-description-field="true" hidden="@(!ProblemSelectedNoteRequiresAnnotation)">
                <label class="screen4-problem-label" for="screen4ProblemDescription">Descrizione blocco o anomalia</label>
                <textarea id="screen4ProblemDescription" class="screen4-problem-textarea" data-note-description-input="true" rows="4" placeholder="Scrivi il blocco o l'anomalia riscontrata" @bind="ProblemDescription" @bind:event="oninput"></textarea>
            </div>

            <div class="screen4-time-display-panel screen4-time-display-panel--problem">
                <div class="screen4-time-display-main" id="screen4ProblemModalDisplay">@FormatTime(ProblemHours, ProblemMinutes)</div>
            </div>
            <div class="screen4-time-grid">
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Ore</div>
                    <div class="screen4-time-hours-controls">
                        <button type="button" class="screen4-time-adjust" data-problem-hours-adjust="-1" @onclick="() => ProblemHours = Math.Max(0, ProblemHours - 1)">−1 ora</button>
                        <div class="screen4-time-value-box" id="screen4ProblemHoursValue">@ProblemHours</div>
                        <button type="button" class="screen4-time-adjust" data-problem-hours-adjust="1" @onclick="() => ProblemHours++">+1 ora</button>
                    </div>
                </div>
                <div class="screen4-time-section">
                    <div class="screen4-time-section__label">Minuti</div>
                    <div class="screen4-minute-options screen4-minute-options--problem">
                        @foreach (var minute in MinuteOptions)
                        {
                            <button type="button"
                                    class="screen4-minute-option@(ProblemMinutes == minute ? " is-active" : string.Empty)"
                                    data-problem-minute-value="@minute"
                                    @onclick="() => ProblemMinutes = minute">@FormatMinuteOption(minute)</button>
                        }
                    </div>
                </div>
            </div>
            <div class="screen4-qty-modal__footer">
                <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--ghost" data-clear-problem="true" @onclick="ClearProblemDraftAsync">Annulla</button>
                <div class="screen4-qty-footer-actions">
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--secondary" data-close-problem-modal="true" @onclick="CloseProblemModal">Chiudi</button>
                    <button type="button" class="screen4-qty-footer-button screen4-qty-footer-button--primary" data-confirm-problem="true" disabled="@(!CanConfirmProblemNote)" @onclick="ConfirmProblemNoteAsync">Aggiungi</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ActionId { get; set; }

    private static readonly string[] QuantityKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "Del", ","];
    private static readonly string[] PinKeys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "Del"];
    private static readonly int[] MinuteOptions = [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55];

    private Screen4ViewModel? Model { get; set; }
    private string? ValidationMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private Screen4SelectedLaunchViewModel? ActiveQuantityLaunch { get; set; }
    private string QuantityKeypadValue { get; set; } = string.Empty;
    private Screen4SelectedLaunchViewModel? ActiveMaterialLotLaunch { get; set; }
    private string MaterialLotChoice { get; set; } = string.Empty;
    private bool ShowTimingModal { get; set; }
    private bool ShowProblemModal { get; set; }
    private bool ShowDatePinModal { get; set; }
    private int TimingHoursDraft { get; set; }
    private int TimingMinutesDraft { get; set; }
    private string DatePin { get; set; } = string.Empty;
    private string DatePinMessage { get; set; } = "Inserisci il PIN dell'operatore abilitato alla modifica data.";
    private bool FocusDatePinAfterRender { get; set; }
    private List<Screen4ProblemNotePostItemModel> ProblemNotes { get; } = [];
    private int ProblemNoteTypeId { get; set; }
    private string ProblemDescription { get; set; } = string.Empty;
    private int ProblemHours { get; set; }
    private int ProblemMinutes { get; set; }
    private HashSet<int> ConfirmedOverLimitOrderIds { get; } = [];
    private HashSet<int> ConfirmedMissingMaterialLotOrderIds { get; } = [];
    private HashSet<int> ExpandedHistoryOrderIds { get; } = [];

    private bool IsGenericDeclaration => Model is not null && FlowService.TryGetWorkAction(Model.ActionId, out var action) && FlowService.IsGenericDeclarationAction(action);
    private bool IsClassicDeclaration => Model is not null
        && !IsGenericDeclaration
        && Model.ActionId.EndsWith("-dichiarazione-produzione", StringComparison.OrdinalIgnoreCase);
    private bool ShowClassicNoteTypeSelect => IsClassicDeclaration && Model?.AvailableNoteTypes.Count > 0;
    private DeclarationNoteTypeViewModel? SelectedNoteType => Model?.AvailableNoteTypes.FirstOrDefault(item => item.Id == Model.SelectedNoteTypeId);
    private bool SelectedNoteRequiresAnnotation => SelectedNoteType?.RequiresAnnotationText == true;
    private bool RequiresProblemNoteTypeSelection => ShowClassicNoteTypeSelect;
    private bool ProblemSelectedNoteRequiresAnnotation => ShowClassicNoteTypeSelect
        && Model?.AvailableNoteTypes.FirstOrDefault(item => item.Id == ProblemNoteTypeId)?.RequiresAnnotationText == true;
    private bool CanConfirmProblemNote => (!RequiresProblemNoteTypeSelection || ProblemNoteTypeId > 0)
        && (ProblemHours > 0 || ProblemMinutes > 0)
        && (!ProblemSelectedNoteRequiresAnnotation || !string.IsNullOrWhiteSpace(ProblemDescription));
    private int TotalTimingMinutes => Model is null ? 0 : (Model.GlobalTimingHours * 60) + Model.GlobalTimingMinutes;
    private bool IsInsertButtonHidden => Model?.IsTimingOnlyMode == true && TotalTimingMinutes <= 0;
    private bool HasDeclaredQuantities => Model?.SelectedLaunches.Any(static launch => launch.QuantityDeclared.GetValueOrDefault() > 0m) == true;
    private bool IsInsertButtonDisabled => Model is null
        || (Model.IsTimingOnlyMode && TotalTimingMinutes <= 0)
        || (!Model.IsTimingOnlyMode && (TotalTimingMinutes <= 0 || !HasDeclaredQuantities));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SyncModalStateAsync();

        if (!firstRender)
        {
            if (FocusDatePinAfterRender)
            {
                FocusDatePinAfterRender = false;
                await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "screen4DatePinInput");
            }

            return;
        }

        await FlowState.EnsureLoadedAsync();
        if (FlowState.SelectedOperatorIds.Count == 0)
        {
            Navigation.NavigateTo("/blazor/operators");
            return;
        }

        LoadModel(null, null);
        if (Model?.AutoFillMaxQuantityFromBarcode == true)
        {
            AutoFillMaxQuantities();
            await FlowState.ConsumeAutoFillMaxQuantityAsync();
        }

        StateHasChanged();
    }

    private void LoadModel(string? validationMessage, string? successMessage)
    {
        Model = FlowService.BuildScreen4Model(FlowState, ActionId, validationMessage, successMessage);
        ValidationMessage = Model.ValidationMessage;
        SuccessMessage = Model.SuccessMessage;
        LoadProblemNotesFromModel();
    }

    private ValueTask SyncModalStateAsync()
    {
        var hasOpenModal = ShowDatePinModal
            || ActiveQuantityLaunch is not null
            || ActiveMaterialLotLaunch is not null
            || ShowTimingModal
            || ShowProblemModal;

        return JsRuntime.InvokeVoidAsync("molinaBlazorModal.setOpen", hasOpenModal);
    }

    private void LoadProblemNotesFromModel()
    {
        ProblemNotes.Clear();
        if (Model is null || string.IsNullOrWhiteSpace(Model.ProblemNotesJson))
        {
            return;
        }

        try
        {
            var notes = JsonSerializer.Deserialize<List<Screen4ProblemNotePostItemModel>>(Model.ProblemNotesJson, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? [];
            ProblemNotes.AddRange(notes);
        }
        catch
        {
            ProblemNotes.Clear();
        }
    }

    private void AutoFillMaxQuantities()
    {
        if (Model is null)
        {
            return;
        }

        foreach (var launch in Model.SelectedLaunches)
        {
            var remaining = GetRemainingQuantity(launch);
            if (remaining > 0)
            {
                launch.QuantityDeclared = remaining;
                if (Model.RequiresMaterialLotSelection && string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode) && launch.AvailableMaterialLots.Count == 1)
                {
                    launch.SelectedMaterialLotCode = launch.AvailableMaterialLots[0];
                }
            }
        }

        UpdateTotalDeclared();
    }

    private string GetLineDisplayTitle()
    {
        if (Model is null)
        {
            return string.Empty;
        }

        var lineDisplayTitle = string.IsNullOrWhiteSpace(Model.LineDisplayName) || string.Equals(Model.LineDisplayName, Model.AreaTitle, StringComparison.OrdinalIgnoreCase)
            ? Model.AreaTitle
            : $"{Model.AreaTitle} - {Model.LineDisplayName}";
        var productionModeText = Model.ProductionMode switch
        {
            "riempimento" => " - Riempimento",
            "macchina" => " - Macchina",
            _ => string.Empty
        };

        return $"{lineDisplayTitle}{productionModeText}";
    }

    private void OnDeclarationDateChanged(ChangeEventArgs args)
    {
        if (Model is null)
        {
            return;
        }

        if (DateTime.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            Model.DeclarationDate = parsedDate.Date;
        }
    }

    private string GetLotCellClass(Screen4SelectedLaunchViewModel launch)
    {
        var className = "screen4-table-lot-cell";
        if (Model?.RequiresMaterialLotSelection == true)
        {
            className += " screen4-table-lot-cell--editable";
        }

        if (!string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode))
        {
            className += " has-material-lot";
        }

        return className;
    }

    private async Task SetMaxQuantityAsync(Screen4SelectedLaunchViewModel launch)
    {
        launch.QuantityDeclared = GetRemainingQuantity(launch);
        if (Model?.RequiresMaterialLotSelection == true && string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode) && launch.AvailableMaterialLots.Count == 1)
        {
            launch.SelectedMaterialLotCode = launch.AvailableMaterialLots[0];
        }

        ConfirmedOverLimitOrderIds.Remove(launch.OrderId);
        UpdateTotalDeclared();
        var message = Model?.RequiresMaterialLotSelection == true
            ? "Qta dichiarata impostata al massimo disponibile. Se necessario seleziona il lotto."
            : "Qta dichiarata impostata al massimo disponibile.";
        var type = Model?.RequiresMaterialLotSelection == true ? "info" : "success";
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", message, type);
    }

    private void OpenQuantityModal(Screen4SelectedLaunchViewModel launch)
    {
        ActiveQuantityLaunch = launch;
        QuantityKeypadValue = launch.QuantityDeclared.HasValue ? FormatQuantity(launch.QuantityDeclared.Value) : string.Empty;
    }

    private void CloseQuantityModal()
    {
        ActiveQuantityLaunch = null;
        QuantityKeypadValue = string.Empty;
    }

    private void PressQuantityKey(string key)
    {
        if (key == "C")
        {
            QuantityKeypadValue = string.Empty;
            return;
        }

        if (key == "Del")
        {
            QuantityKeypadValue = QuantityKeypadValue.Length == 0 ? string.Empty : QuantityKeypadValue[..^1];
            return;
        }

        if (key == "," && QuantityKeypadValue.Contains(',', StringComparison.Ordinal))
        {
            return;
        }

        QuantityKeypadValue = key == "," && string.IsNullOrWhiteSpace(QuantityKeypadValue)
            ? "0,"
            : QuantityKeypadValue + key;
    }

    private async Task ConfirmQuantityAsync()
    {
        if (ActiveQuantityLaunch is null)
        {
            return;
        }

        var value = ParseQuantity(QuantityKeypadValue);
        if (!value.HasValue || value.Value <= 0)
        {
            ValidationMessage = "Inserisci una qta dichiarata valida.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage);
            return;
        }

        var isOverLimit = value.Value > GetRemainingQuantity(ActiveQuantityLaunch);
        if (isOverLimit)
        {
            var confirmed = await JsRuntime.InvokeAsync<bool>(
                "molinaBlazorDialog.confirm",
                "La qta dichiarata supera la qta residua disponibile per questo lotto. Tocca Conferma comunque solo se vuoi registrarla davvero.",
                "Conferma qta superiore al residuo",
                "Conferma comunque",
                "Torna ai dati",
                "!");
            if (!confirmed)
            {
                return;
            }
        }

        ActiveQuantityLaunch.QuantityDeclared = value.Value;
        if (Model?.RequiresMaterialLotSelection == true
            && string.IsNullOrWhiteSpace(ActiveQuantityLaunch.SelectedMaterialLotCode)
            && ActiveQuantityLaunch.AvailableMaterialLots.Count == 1)
        {
            ActiveQuantityLaunch.SelectedMaterialLotCode = ActiveQuantityLaunch.AvailableMaterialLots[0];
        }

        if (isOverLimit)
        {
            ConfirmedOverLimitOrderIds.Add(ActiveQuantityLaunch.OrderId);
        }
        else
        {
            ConfirmedOverLimitOrderIds.Remove(ActiveQuantityLaunch.OrderId);
        }

        var hasMaterialLot = Model?.RequiresMaterialLotSelection != true || !string.IsNullOrWhiteSpace(ActiveQuantityLaunch.SelectedMaterialLotCode);
        UpdateTotalDeclared();
        CloseQuantityModal();
        await JsRuntime.InvokeVoidAsync(
            "molinaBlazorDialog.toast",
            hasMaterialLot ? "Qta dichiarata aggiornata." : "Qta dichiarata aggiornata. Se necessario seleziona il lotto.",
            hasMaterialLot ? "success" : "info");
    }

    private async Task ClearActiveQuantityAsync()
    {
        if (ActiveQuantityLaunch is not null)
        {
            ActiveQuantityLaunch.QuantityDeclared = null;
            ActiveQuantityLaunch.SelectedMaterialLotCode = string.Empty;
            ConfirmedOverLimitOrderIds.Remove(ActiveQuantityLaunch.OrderId);
            ConfirmedMissingMaterialLotOrderIds.Remove(ActiveQuantityLaunch.OrderId);
            UpdateTotalDeclared();
        }

        CloseQuantityModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Qta dichiarata annullata.", "info");
    }

    private async Task ClearSlotAsync(Screen4SelectedLaunchViewModel launch)
    {
        launch.QuantityDeclared = null;
        launch.SelectedMaterialLotCode = string.Empty;
        ConfirmedOverLimitOrderIds.Remove(launch.OrderId);
        ConfirmedMissingMaterialLotOrderIds.Remove(launch.OrderId);
        UpdateTotalDeclared();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Dati della riga annullati.", "info");
    }

    private async Task OpenMaterialLotModalAsync(Screen4SelectedLaunchViewModel launch)
    {
        if (Model?.RequiresMaterialLotSelection != true)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(launch.MaterialLotValidationMessage) || launch.AvailableMaterialLots.Count == 0)
        {
            var message = !string.IsNullOrWhiteSpace(launch.MaterialLotValidationMessage)
                ? launch.MaterialLotValidationMessage
                : "Non ci sono lotti materiale disponibili per questo articolo.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", message, "warning");
            return;
        }

        ActiveMaterialLotLaunch = launch;
        MaterialLotChoice = launch.SelectedMaterialLotCode;
        if (string.IsNullOrWhiteSpace(MaterialLotChoice) && launch.AvailableMaterialLots.Count == 1)
        {
            MaterialLotChoice = launch.AvailableMaterialLots[0];
        }
    }

    private void CloseMaterialLotModal()
    {
        ActiveMaterialLotLaunch = null;
        MaterialLotChoice = string.Empty;
    }

    private void ClearMaterialLotChoice()
    {
        MaterialLotChoice = string.Empty;
    }

    private void SetMaterialLotChoice(string materialLot)
    {
        MaterialLotChoice = materialLot;
    }

    private string GetMaterialLotHelpText()
    {
        return string.IsNullOrWhiteSpace(MaterialLotChoice)
            ? "Seleziona il lotto toccando uno dei lotti disponibili."
            : "Lotto selezionato correttamente.";
    }

    private string GetMaterialLotHelpClass()
    {
        return string.IsNullOrWhiteSpace(MaterialLotChoice)
            ? "material-lot-scan-help"
            : "material-lot-scan-help is-success";
    }

    private async Task ConfirmMaterialLotAsync()
    {
        if (string.IsNullOrWhiteSpace(MaterialLotChoice))
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Seleziona il lotto prima di confermare.", "warning");
            return;
        }

        if (ActiveMaterialLotLaunch is not null)
        {
            ActiveMaterialLotLaunch.SelectedMaterialLotCode = MaterialLotChoice;
            ConfirmedMissingMaterialLotOrderIds.Remove(ActiveMaterialLotLaunch.OrderId);
        }

        CloseMaterialLotModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Lotto aggiornato.", "success");
    }

    private void UpdateTotalDeclared()
    {
        if (Model is not null)
        {
            Model.TotalDeclared = Model.SelectedLaunches.Sum(static item => item.QuantityDeclared ?? 0m);
        }
    }

    private decimal GetRemainingQuantity(Screen4SelectedLaunchViewModel launch)
    {
        return Math.Max((launch.QuantityToProduce ?? 0m) - (launch.QuantityProduced ?? 0m), 0m);
    }

    private void ToggleHistory(int orderId)
    {
        if (!ExpandedHistoryOrderIds.Add(orderId))
        {
            ExpandedHistoryOrderIds.Remove(orderId);
        }
    }

    private void OpenTimingModal()
    {
        if (Model is not null)
        {
            TimingHoursDraft = Model.GlobalTimingHours;
            TimingMinutesDraft = Model.GlobalTimingMinutes;
        }

        ShowTimingModal = true;
    }

    private void CloseTimingModal()
    {
        if (Model is not null)
        {
            TimingHoursDraft = Model.GlobalTimingHours;
            TimingMinutesDraft = Model.GlobalTimingMinutes;
        }

        ShowTimingModal = false;
    }

    private void AdjustTimingHours(int delta)
    {
        TimingHoursDraft = Math.Max(0, TimingHoursDraft + delta);
    }

    private async Task ClearTimingAsync()
    {
        if (Model is not null)
        {
            Model.GlobalTimingHours = 0;
            Model.GlobalTimingMinutes = 0;
        }

        TimingHoursDraft = 0;
        TimingMinutesDraft = 0;
        CloseTimingModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Timing annullato.", "info");
    }

    private async Task ConfirmTimingAsync()
    {
        if (Model is not null)
        {
            Model.GlobalTimingHours = TimingHoursDraft;
            Model.GlobalTimingMinutes = TimingMinutesDraft;
        }

        CloseTimingModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Timing aggiornato per tutti i lotti. Verrà moltiplicato per il numero di operatori in fase di inserimento.", "success");
    }

    private void OpenProblemModal()
    {
        if (Model is null)
        {
            return;
        }

        ProblemNoteTypeId = 0;
        ProblemDescription = string.Empty;
        ProblemHours = 0;
        ProblemMinutes = 0;
        ShowProblemModal = true;
    }

    private void CloseProblemModal()
    {
        ShowProblemModal = false;
    }

    private void ClearProblemDraft()
    {
        ProblemNoteTypeId = 0;
        ProblemDescription = string.Empty;
        ProblemHours = 0;
        ProblemMinutes = 0;
    }

    private async Task ClearProblemDraftAsync()
    {
        ClearProblemDraft();
        CloseProblemModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Inserimento nota produzione o blocco annullato.", "info");
    }

    private async Task ConfirmProblemNoteAsync()
    {
        if (RequiresProblemNoteTypeSelection && ProblemNoteTypeId <= 0)
        {
            ValidationMessage = "Seleziona un tipo nota prima di confermare il blocco o l'anomalia.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
            return;
        }

        if (ProblemHours <= 0 && ProblemMinutes <= 0)
        {
            ValidationMessage = "Inserisci il timing del blocco o dell'anomalia prima di confermare.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
            return;
        }

        if (ProblemSelectedNoteRequiresAnnotation && string.IsNullOrWhiteSpace(ProblemDescription))
        {
            ValidationMessage = "Inserisci la descrizione per la tipologia selezionata.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
            return;
        }

        ProblemNotes.Add(new Screen4ProblemNotePostItemModel
        {
            NoteTypeId = ProblemNoteTypeId,
            Description = ProblemDescription.Trim(),
            Hours = ProblemHours,
            Minutes = ProblemMinutes
        });
        ValidationMessage = null;
        ClearProblemDraft();
        CloseProblemModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Nota produzione o blocco aggiunto.", "success");
    }

    private async Task ClearProblemNotesAsync()
    {
        ProblemNotes.Clear();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Nota produzione o blocco rimossa.", "info");
    }

    private async Task RemoveProblemNoteAsync(int index)
    {
        if (index >= 0 && index < ProblemNotes.Count)
        {
            ProblemNotes.RemoveAt(index);
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", "Nota produzione o blocco rimossa.", "info");
        }
    }

    private string GetProblemSummary()
    {
        if (ProblemNotes.Count == 0)
        {
            return "Nessuna nota produzione o blocco";
        }

        if (ProblemNotes.Count == 1)
        {
            return FormatProblemNote(ProblemNotes[0]);
        }

        var totalMinutes = ProblemNotes.Sum(static note => note.TotalMinutes);
        return $"Totale: {FormatTime(totalMinutes / 60, totalMinutes % 60).Replace(" h ", " h e ")}";
    }

    private string FormatProblemNote(Screen4ProblemNotePostItemModel note)
    {
        var parts = new List<string>
        {
            Model?.AvailableNoteTypes.FirstOrDefault(item => item.Id == note.NoteTypeId)?.Description ?? "Nota produzione/blocco"
        };

        if (!string.IsNullOrWhiteSpace(note.Description))
        {
            parts.Add(note.Description.Trim());
        }

        if (note.TotalMinutes > 0)
        {
            parts.Add($"({FormatTime(note.TotalMinutes / 60, note.TotalMinutes % 60)})");
        }

        return string.Join(" ", parts);
    }

    private async Task RequestDateEditAsync()
    {
        if (Model?.IsDeclarationDateEditable == true)
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "screen4DeclarationDateInput");
            return;
        }

        OpenDatePinModal();
    }

    private void OpenDatePinModal()
    {
        DatePin = string.Empty;
        DatePinMessage = "Inserisci il PIN dell'operatore abilitato alla modifica data.";
        ShowDatePinModal = true;
        FocusDatePinAfterRender = true;
    }

    private void CloseDatePinModal()
    {
        ShowDatePinModal = false;
        DatePin = string.Empty;
        DatePinMessage = "Inserisci il PIN dell'operatore abilitato alla modifica data.";
    }

    private void OnDatePinInput(ChangeEventArgs args)
    {
        DatePin = NormalizeDatePin(args.Value?.ToString());
    }

    private async Task PressDatePinKeyAsync(string key)
    {
        if (key == "C")
        {
            DatePin = string.Empty;
        }
        else if (key == "Del")
        {
            DatePin = DatePin.Length == 0 ? string.Empty : DatePin[..^1];
        }
        else
        {
            DatePin = NormalizeDatePin(DatePin + key);
        }

        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "screen4DatePinInput");
    }

    private async Task HandleDatePinKeydownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmDatePinAsync();
        }
    }

    private async Task ConfirmDatePinAsync()
    {
        if (Model is null)
        {
            return;
        }

        var result = FlowService.AuthorizeDeclarationDateEdit(FlowState, DatePin);
        DatePinMessage = result.Message;
        if (!result.Success)
        {
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", result.Message, "warning");
            await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusAndSelectById", "screen4DatePinInput");
            return;
        }

        await FlowState.SetDateEditAuthorizedAsync(true);
        Model.IsDeclarationDateEditable = true;
        CloseDatePinModal();
        await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", result.Message, "success");
        await JsRuntime.InvokeVoidAsync("molinaBlazorDom.focusById", "screen4DeclarationDateInput");
    }

    private static string NormalizeDatePin(string? value)
    {
        return new string((value ?? string.Empty).Where(char.IsDigit).ToArray());
    }

    private async Task InsertAsync()
    {
        if (Model is null)
        {
            return;
        }

        ValidationMessage = null;
        var postModel = BuildPostModel();
        var timingMinutes = postModel.GetTimingMinutesPerOperator();
        if (Model.IsTimingOnlyMode && timingMinutes <= 0)
        {
            ValidationMessage = "Inserisci il timing prima di premere Inserisci.";
            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
            return;
        }

        if (!Model.IsTimingOnlyMode)
        {
            if (timingMinutes <= 0)
            {
                ValidationMessage = "Inserisci il timing prima di premere Inserisci.";
                await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
                return;
            }

            if (ProblemNotes.Sum(static note => note.TotalMinutes) >= timingMinutes)
            {
                ValidationMessage = "Il timing totale deve essere maggiore della somma delle note produzione o blocchi.";
                await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
                return;
            }

            var declaredRows = postModel.GetDeclaredRows();
            if (declaredRows.Count == 0)
            {
                ValidationMessage = "Inserisci almeno una qta dichiarata prima di premere Inserisci.";
                await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage, "warning");
                return;
            }

            var overLimitLaunch = Model.SelectedLaunches.FirstOrDefault(launch =>
                launch.QuantityDeclared.HasValue
                && launch.QuantityDeclared.Value > GetRemainingQuantity(launch)
                && !ConfirmedOverLimitOrderIds.Contains(launch.OrderId));
            if (overLimitLaunch is not null)
            {
                var confirmed = await JsRuntime.InvokeAsync<bool>(
                    "molinaBlazorDialog.confirm",
                    "La qta dichiarata supera la qta residua disponibile per questo lotto. Tocca Conferma comunque solo se vuoi registrarla davvero.",
                    "Conferma qta superiore al residuo",
                    "Conferma comunque",
                    "Torna ai dati",
                    "!");
                if (!confirmed)
                {
                    return;
                }

                ConfirmedOverLimitOrderIds.Add(overLimitLaunch.OrderId);
                postModel = BuildPostModel();
            }

            var missingMaterialLotLaunch = Model.RequiresMaterialLotSelection
                ? Model.SelectedLaunches.FirstOrDefault(launch =>
                    launch.QuantityDeclared.HasValue
                    && launch.QuantityDeclared.Value > 0
                    && string.IsNullOrWhiteSpace(launch.SelectedMaterialLotCode)
                    && launch.AvailableMaterialLots.Count > 0
                    && !ConfirmedMissingMaterialLotOrderIds.Contains(launch.OrderId))
                : null;
            if (missingMaterialLotLaunch is not null)
            {
                var confirmed = await JsRuntime.InvokeAsync<bool>(
                    "molinaBlazorDialog.confirm",
                    "Ci sono lotti disponibili in giacenza. Vuoi salvare comunque senza dichiarare il lotto materiale?",
                    "Conferma senza lotto",
                    "Salva senza lotto",
                    "Torna ai dati",
                    "!");
                if (!confirmed)
                {
                    return;
                }

                ConfirmedMissingMaterialLotOrderIds.Add(missingMaterialLotLaunch.OrderId);
                postModel = BuildPostModel();
            }
        }

        var result = FlowService.InsertDeclarations(FlowState, postModel);
        if (!result.Success)
        {
            if (result.InvalidModel is not null)
            {
                Model = result.InvalidModel;
                ValidationMessage = Model.ValidationMessage;
                SuccessMessage = null;
                LoadProblemNotesFromModel();
            }
            else
            {
                ValidationMessage = result.Message;
            }

            await JsRuntime.InvokeVoidAsync("molinaBlazorDialog.toast", ValidationMessage ?? "Non riesco a inserire la dichiarazione.", "warning");
            return;
        }

        if (result.ClearFlow)
        {
            await FlowState.CompleteFlowAsync(result.Message ?? "Operazione inserita correttamente.");
            Navigation.NavigateTo("/blazor");
            return;
        }

        SuccessMessage = result.Message;
    }

    private Screen4InsertPostModel BuildPostModel()
    {
        if (Model is null)
        {
            return new Screen4InsertPostModel();
        }

        return new Screen4InsertPostModel
        {
            ActionId = Model.ActionId,
            ProductionMode = Model.ProductionMode,
            DeclarationDate = Model.DeclarationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ConfirmedOverLimitOrderIds = string.Join(',', ConfirmedOverLimitOrderIds.OrderBy(static id => id)),
            ConfirmedMissingMaterialLotOrderIds = string.Join(',', ConfirmedMissingMaterialLotOrderIds.OrderBy(static id => id)),
            GlobalTimingHours = Model.GlobalTimingHours,
            GlobalTimingMinutes = Model.GlobalTimingMinutes,
            SelectedNoteTypeId = Model.SelectedNoteTypeId,
            GlobalProblemDescription = Model.GlobalProblemDescription ?? string.Empty,
            GlobalProblemHours = Model.GlobalProblemHours,
            GlobalProblemMinutes = Model.GlobalProblemMinutes,
            ProblemNotesJson = JsonSerializer.Serialize(ProblemNotes),
            Rows = Model.SelectedLaunches
                .Select(static launch => new Screen4InsertRowPostItemModel
                {
                    OrderId = launch.OrderId,
                    QuantityDeclared = launch.QuantityDeclared.HasValue ? launch.QuantityDeclared.Value.ToString("0.##", CultureInfo.InvariantCulture) : string.Empty,
                    SelectedMaterialLotCode = launch.SelectedMaterialLotCode
                })
                .ToList()
        };
    }

    private string GetBackUrl()
    {
        if (Model?.BackActionName == "Launches")
        {
            var productionModeQuery = string.IsNullOrWhiteSpace(Model.ProductionMode)
                ? string.Empty
                : $"?productionMode={Uri.EscapeDataString(Model.ProductionMode)}";
            return $"/blazor/launches/{Uri.EscapeDataString(Model.ActionId)}{productionModeQuery}";
        }

        return "/blazor/work-menu";
    }

    private static string FormatTime(int hours, int minutes)
    {
        return $"{Math.Max(0, hours):00} h {Math.Max(0, minutes):00} m";
    }

    private static string? GetKeypadValue(string key)
    {
        return key is "C" or "Del" ? null : key;
    }

    private static string? GetKeypadAction(string key)
    {
        return key switch
        {
            "C" => "clear",
            "Del" => "backspace",
            _ => null
        };
    }

    private static string FormatBool(bool value)
    {
        return value ? "true" : "false";
    }

    private static string FormatMinuteOption(int minutes)
    {
        return minutes == 0 ? "00" : minutes.ToString(CultureInfo.InvariantCulture);
    }

    private static string FormatQuantity(decimal value)
    {
        return value.ToString("0.##", CultureInfo.GetCultureInfo("it-IT"));
    }

    private static string FormatQuantityInvariant(decimal value)
    {
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static decimal? ParseQuantity(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return null;
        }

        var normalizedValue = rawValue.Trim().Replace(" ", string.Empty).Replace(",", ".");
        if (decimal.TryParse(normalizedValue, NumberStyles.Number, CultureInfo.InvariantCulture, out var invariantValue))
        {
            return invariantValue;
        }

        return decimal.TryParse(rawValue, NumberStyles.Number, CultureInfo.GetCultureInfo("it-IT"), out var italianValue)
            ? italianValue
            : null;
    }
}
